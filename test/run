check "a link inside a code span is a sample, not a link" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c 'not-a-link')" 0
check "a link inside a fenced block is a sample, not a link" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c 'also-not-a-link')" 0
check "an import inside a code span is a sample, not an import" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.md | grep -c 'not-an-import')" 0
check "a valid import is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 AGENTS.md | grep -c 'CLAUDE\.md')" 0
check "an address is not an import" \
  "$(refmatch "$GR" HYG-PHA-002 AGENTS.md | grep -c 'example\.com')" 0
# The import grammar. Each negative here is a shape that ordinary prose is full
# of, and each positive is an import the documented syntax really writes.
check "every import in a memory file is reported once each" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | wc -l | tr -d ' ')" 3
check "an import written with a leading ./ is read" \
