check "two imports on one line are both read" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -c '^docs/missing\.md$')" 1
check "an address and an import on one line are told apart" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -c '^docs/missing-with-email\.md$')" 1
check "a valid import in a memory file is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -c 'CLAUDE\.md')" 0
check "an address is not an import" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -c 'company\.org')" 0
check "a handle is not an import" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -Ec '^(nouvic|someone)$')" 0
check "a bare word and a package scope are not imports" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -Ec '^(notes|company/pkg)$')" 0
check "an import inside a code span is a sample, not an import" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -c 'in-a-code-span')" 0
check "an import inside a fenced block is a sample, not an import" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -c 'in-a-fence')" 0

# Which files are read for imports comes from the exposure table's imports
# column and from nothing else.
check "an import in a nested memory file is joined from that file" \
