#!/usr/bin/env bash
# test/run — the precision suite.
#
# Most of these are NEGATIVE tests: ordinary code and ordinary prose that must
# pass. A scanner that flags a normal codebase gets uninstalled the same day, so
# a false positive is a worse bug here than a miss.
#
# Add a test before adding a pattern.

set -uo pipefail
HYG="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
PASS=0; FAIL=0
# install-claude resolves its destination as ${CLAUDE_CONFIG_DIR:-$HOME/.claude}.
# The installer tests below point HOME at a fixture and expect the install to
# land there; an ambient CLAUDE_CONFIG_DIR silently outranks HOME, which sends
# the fixture install into the operator's real Claude configuration and fails
# the assertions for a reason that has nothing to do with the code under test.
unset CLAUDE_CONFIG_DIR
# The rule registry is data, not detector logic: the tests below assert that
# every rule has an entry, so they need the list.
. "$HYG/lib/rules.sh"

ok()   { PASS=$((PASS+1)); printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  \033[31m✗\033[0m %s\n' "$1"; }
check(){ [ "$2" = "$3" ] && ok "$1" || bad "$1  (expected $3, got $2)"; }

# The verdict reads "clean." at zero findings and "N candidate findings"
# otherwise, so a test that wants the number reads it from either shape.
scan_count() { "$HYG/bin/scan" "$@" 2>/dev/null | awk '
  /^  clean\./ { print 0; exit }
  /^  [0-9]+ candidate finding/ { print $1; exit }'; }

newrepo() {
  local d="$TMP/$1"; rm -rf "$d"; mkdir -p "$d/content"
  git -C "$d" init -q -b main
  git -C "$d" config user.email t@t; git -C "$d" config user.name t
  printf 'export const a=1;\n' > "$d/seed.ts"
  "$HYG/install" "$d" >/dev/null 2>&1
  git -C "$d" add -A >/dev/null; git -C "$d" commit -q -m "feat: seed" >/dev/null 2>&1
  printf '%s' "$d"
}

# Never write outside the sandbox. An earlier version of this file relied on a
# `cd` inside a $(…) subshell, which does not persist — and it committed test
# fixtures into the repo the suite was run from.
guard() {
  case "$1" in
    "$TMP"/*) : ;;
    *) printf '\n  ABORT: refusing to write outside %s (got %s)\n\n' "$TMP" "$1" >&2
       exit 1 ;;
  esac
}

# commits <repo> <file> <contents> <message>  -> "pass" | "block"
commits() {
  guard "$1"
  printf '%s' "$3" > "$1/$2"
  git -C "$1" add -A >/dev/null 2>&1
  if git -C "$1" commit -q -m "$4" >/dev/null 2>&1; then printf 'pass'; else
    # Remove the fixture, or `git add -A` re-stages it in every later test and
    # every subsequent commit is blocked by the *previous* test's file.
    git -C "$1" reset -q HEAD >/dev/null 2>&1; rm -f "$1/$2"; printf 'block'; fi
}

echo
echo "  ── comments that describe code must PASS ────────────────"
D="$(newrepo a)"
check "plain code"                "$(commits "$D" x.ts 'export const x=1;' 'feat: x')" pass
check "'can never block a deploy'" \
  "$(commits "$D" y.ts '// a CDN outage can never block a deploy
export const y=1;' 'feat: y')" pass
check "'do not let a hung gateway hang the UI'" \
  "$(commits "$D" z.ts '// do not let a hung gateway hang the UI
export const z=1;' 'feat: z')" pass
check "'returns null when the cache is cold'" \
  "$(commits "$D" w.ts '// returns null when the cache is cold
export const w=1;' 'feat: w')" pass
check "TODO without a ruling" \
  "$(commits "$D" t.ts '// TODO: handle the empty case
export const t=1;' 'feat: t')" pass
check "ISO date in an ordinary source comment" \
  "$(commits "$D" date.ts '// ISO 8601 example: 2026-09-01
export const date="2026-09-01";' 'test: date example')" pass
mkdir -p "$D/tests/unit" "$D/__tests__" "$D/spec"
check "hardcoded date in tests/ fixture" \
  "$(commits "$D" tests/unit/date.ts '// Fixture boundary 2026-09-01
export const date="2026-09-01";' 'test: fixed date fixture')" pass
check "governance-like prose in __tests__/ remains test data" \
  "$(commits "$D" __tests__/messages.ts '// NEVER change this expected fixture
export const message="NEVER change this";' 'test: instruction fixture')" pass
check "spec/ directory is recognized as a test suite" \
  "$(commits "$D" spec/date_spec.rb '# Boundary 2026-09-01
DATE = "2026-09-01"' 'test: ruby date fixture')" pass

echo
echo "  ── product prose in exempt paths must PASS ──────────────"
check "content/ 'we do not sell your data, we never share it'" \
  "$(commits "$D" content/legal.ts 'export const s="We do not sell your data. We never share it.";' 'docs: legal')" pass

echo
echo "  ── governance must BLOCK ───────────────────────────────"
check "⛔ marker + ALL CAPS + date + doc ref" \
  "$(commits "$D" g1.ts '// ⛔ NEVER change this — owner ruling 2026-08-08, see DESIGN.md §12
export const g=1;' 'feat: g')" block
check "'never change this file by hand'" \
  "$(commits "$D" g2.ts '// never change this file by hand
export const g2=1;' 'feat: g2')" block
check "owner law" \
  "$(commits "$D" g3.ts '// Owner law: price lives below the fold
export const g3=1;' 'feat: g3')" block
check "descriptive incident date in production code" \
  "$(commits "$D" gdate.ts '// Incident snapshot 2026-09-01
export const gd=1;' 'feat: dated incident')" pass
check "argument residue" \
  "$(commits "$D" g4.ts '// the owner rejected this twice; we reverted it the third time
export const g4=1;' 'feat: g4')" block
check "attributed preference in project prose" \
  "$(commits "$D" memory.md 'The user wanted the blue version after the discussion.' 'docs: memory')" block
check "impersonal conceptual prose" \
  "$(commits "$D" architecture.md 'Monetary amounts use integer minor units.' 'docs: architecture')" pass
# A Cursor rule is markdown with frontmatter, and it is read the same way as a
# document wherever it sits: it is durable agent memory, so prose in one is
# scanned as prose rather than passed over as an unrecognised extension.
mkdir -p "$D/.cursor/rules"
check "a Cursor rule is read as prose" \
  "$(commits "$D" .cursor/rules/memory.mdc 'The user wanted the blue version after the discussion.' 'docs: cursor rule')" block

B="$(newrepo blocked-message)"
printf '%s\n' '// Owner ruling: never change this file by hand' 'export const b=1;' > "$B/blocked.ts"
git -C "$B" add blocked.ts >/dev/null 2>&1
BLOCK_MSG="$(git -C "$B" commit -m 'test: exercise block guidance' 2>&1)"
check "block message rejects route-changing workarounds" \
  "$(printf '%s' "$BLOCK_MSG" | grep -c 'Do not move, reword, unstage, exempt, or bypass')" 1
check "block message prescribes the project scanner" \
  "$(printf '%s' "$BLOCK_MSG" | grep -c '\.githooks/scan')" 1
check "installed project scanner is executable" \
  "$([ -x "$B/.githooks/scan" ] && echo yes || echo no)" yes
check "installed project scanner runs independently" \
  "$("$B/.githooks/scan" "$B" 2>/dev/null | grep -c 'governance in comments')" 1

echo
echo "  ── commit messages ─────────────────────────────────────"
check "conventional passes"      "$(commits "$D" m1.ts 'export const m1=1;' 'fix(nav): point CTA at membership')" pass
check "'Handoff:' blocks"        "$(commits "$D" m2.ts 'export const m2=1;' 'Handoff: nav corrections')" block
check "'wip' blocks"             "$(commits "$D" m3.ts 'export const m3=1;' 'wip')" block
check "'added a thing' blocks"   "$(commits "$D" m4.ts 'export const m4=1;' 'added a thing')" block
check "Merge commits pass"       "$(commits "$D" m5.ts 'export const m5=1;' 'Merge branch feature/x')" pass

echo
echo "  ── scan is read-only and honest ────────────────────────"
BEFORE="$(git -C "$D" status --porcelain | wc -l | tr -d ' ')"
"$HYG/bin/scan" "$D" >/dev/null 2>&1
check "scan exits 0"             "$?" 0
check "scan writes nothing"      "$(git -C "$D" status --porcelain | wc -l | tr -d ' ')" "$BEFORE"

CLEAN="$TMP/clean"; mkdir -p "$CLEAN"
{ echo '// Money is stored in minor units; callers pass integers.'
  echo 'export function add(a, b) { return a + b; }'
  for i in $(seq 1 30); do echo "export const k$i = $i;"; done
  echo '// Falls back to the default locale when the header is absent.'
  echo 'export const locale = (h) => h || "en";'
} > "$CLEAN/m.ts"
check "clean repo reports clean" \
  "$("$HYG/bin/scan" "$CLEAN" 2>/dev/null | grep -c 'clean\.')" 1

UNTRACKED="$(newrepo untracked-scan)"
printf '%s\n' '// Owner ruling: never change this file' > "$UNTRACKED/new-source.ts"
printf '%s\n' 'ignored-source.ts' > "$UNTRACKED/.gitignore"
printf '%s\n' '// Owner ruling: never change this file' > "$UNTRACKED/ignored-source.ts"
SCAN_NEW="$("$HYG/bin/scan" "$UNTRACKED" 2>/dev/null)"
check "scan includes untracked source" "$(printf '%s' "$SCAN_NEW" | grep -c 'new-source.ts')" 1
check "scan respects gitignored source" "$(printf '%s' "$SCAN_NEW" | grep -c 'ignored-source.ts')" 0

echo
echo "  ── lifecycle ───────────────────────────────────────────"
check "install is idempotent" \
  "$("$HYG/install" "$D" 2>/dev/null | grep -c 'already at')" 1
"$HYG/uninstall" "$D" >/dev/null 2>&1
check "uninstall unsets hooksPath" "$(git -C "$D" config --get core.hooksPath || echo unset)" unset
check "uninstall removes .githooks" "$([ -d "$D/.githooks" ] && echo present || echo gone)" gone

echo
echo "  ── rulings ─────────────────────────────────────────────"
export HYGIENE_RULINGS="$TMP/rulings.txt"
"$HYG/bin/rulings" add "never propose ship gates" '(ship|launch)[ -]?gate' >/dev/null
check "matching sentence trips"  "$("$HYG/bin/rulings" test 'add a ship gate' | grep -c 'trips:')" 1
check "unrelated sentence passes" "$("$HYG/bin/rulings" test 'deploy to railway' | grep -c 'trips nothing')" 1

# Intake and backtests must only ever see fixture transcripts under $TMP.
export HYGIENE_PROJECTS_DIR="$TMP/projects"
mkdir -p "$HYGIENE_PROJECTS_DIR"

if command -v python3 >/dev/null 2>&1; then
  mkt() {
    python3 - "$1" "$2" "$TMP/t.jsonl" <<'PY'
import json,sys
u,a,p = sys.argv[1],sys.argv[2],sys.argv[3]
with open(p,'w') as f:
    f.write(json.dumps({"type":"user","message":{"role":"user","content":u}})+"\n")
    f.write(json.dumps({"type":"assistant","message":{"role":"assistant",
        "content":[{"type":"text","text":a}]}})+"\n")
PY
    printf '{"transcript_path":"%s","stop_hook_active":false}' "$TMP/t.jsonl"
  }
  run(){ mkt "$1" "$2" | python3 "$HYG/claude/stop-rulings.py" >/dev/null 2>&1; \
         [ $? = 2 ] && printf 'block' || printf 'pass'; }
  check "unprompted mention blocks"  "$(run 'how do I deploy?' 'add a ship gate here')" block
  check "user raised it first passes" "$(run 'what was the ship gate?' 'the ship gate blocked it')" pass
  check "unrelated reply passes"      "$(run 'how do I deploy?' 'push to railway')" pass
else
  echo "  - python3 absent, skipping Stop hook tests"
fi

echo
echo "  ── action rulings — PreToolUse ─────────────────────────"
if command -v python3 >/dev/null 2>&1; then
  PTR="$HYG/claude/pretooluse-rulings.py"
  RUL="$HYG/bin/rulings"
  AR="$TMP/action-rulings.txt"
  export HYGIENE_RULINGS="$AR"

  # mka <user_msg> <tool> <input_json> — a PreToolUse payload whose transcript
  # holds one genuine user message. Paths in fixtures need not exist on disk;
  # the hook only pattern-matches.
  mka() {
    python3 - "$1" "$2" "$3" "$TMP/a.jsonl" <<'PY'
import json,sys
u,tn,ti,p = sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
with open(p,'w') as f:
    f.write(json.dumps({"type":"user","message":{"role":"user","content":u}})+"\n")
print(json.dumps({"transcript_path":p,"tool_name":tn,"tool_input":json.loads(ti)}))
PY
  }
  runa(){ mka "$1" "$2" "$3" | python3 "$PTR" >/dev/null 2>&1; \
          [ $? = 2 ] && printf 'block' || printf 'pass'; }

  : > "$AR"
  check "empty rulings file: Write passes" \
    "$(runa 'hi' Write '{"file_path":"/p/app.ts","content":"export const a=1;"}')" pass

  printf '%s\n' 'never propose ship gates :: (ship|launch)[ -]?gate' > "$AR"
  check "speech-only file: Write passes" \
    "$(runa 'hi' Write '{"file_path":"/p/app.ts","content":"export const a=1;"}')" pass
  check "speech regex matching an action stays speech" \
    "$(runa 'hi' Write '{"file_path":"/p/app.ts","content":"add a ship gate"}')" pass

  printf '%s\n' 'never: skills are not registered; skills-library only :: \.claude/skills/' > "$AR"
  check "never: fires on file_path" \
    "$(runa 'hi' Write '{"file_path":"/u/.claude/skills/x/SKILL.md","content":"x"}')" block
  check "never: fires on content" \
    "$(runa 'hi' Write '{"file_path":"/p/notes.txt","content":"ln -s here ~/.claude/skills/x"}')" block
  check "never: fires through Bash" \
    "$(runa 'hi' Bash '{"command":"mkdir -p ~/.claude/skills/x"}')" block
  check "never: unrelated action passes" \
    "$(runa 'hi' Write '{"file_path":"/p/app.ts","content":"export const a=1;"}')" pass
  check "action ruling does not trip the Stop hook" \
    "$(run 'how do I add a skill?' 'put it under ~/.claude/skills/ perhaps')" pass

  printf '%s\n' 'ask: global npm installs need a yes :: npm install (-g|--global)' > "$AR"
  check "ask: unrequested action blocks" \
    "$(runa 'set up the project' Bash '{"command":"npm install -g typescript"}')" block
  check "ask: stands down when the user asked" \
    "$(runa 'please npm install -g typescript' Bash '{"command":"npm install -g typescript"}')" pass
  MSG="$(mka 'set up the project' Bash '{"command":"npm install -g typescript"}' | python3 "$PTR" 2>&1 >/dev/null)"
  check "block message names the ruling" \
    "$(printf '%s' "$MSG" | grep -c 'global npm installs need a yes')" 1

  printf '%s\n' 'never: broken :: ([unclosed' > "$AR"
  check "malformed regex fails open" \
    "$(runa 'hi' Write '{"file_path":"/u/.claude/skills/x","content":"x"}')" pass
  printf 'not json' | python3 "$PTR" >/dev/null 2>&1
  check "unparseable stdin exits 0" "$?" 0
  printf '%s\n' 'never: no skill registration :: \.claude/skills/' > "$AR"
  printf '{"transcript_path":"%s","tool_name":"Write","tool_input":{"file_path":"/u/.claude/skills/x"}}' \
    "$TMP/absent.jsonl" | python3 "$PTR" >/dev/null 2>&1
  check "missing transcript still evaluates" "$?" 2

  check "blocks land in hits.log" "$([ -s "$TMP/hits.log" ] && echo yes || echo no)" yes
  check "stats reports per-ruling counts" \
    "$("$RUL" stats | grep -c 'skills are not registered')" 1

  # A catastrophic-backtracking regex must fail open, not wedge the session.
  printf '%s\n' 'never: redos probe :: (a+)+b$' > "$AR"
  check "pathological regex cannot hang the hook" \
    "$(runa 'hi' Write '{"file_path":"/p/x.ts","content":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}')" pass
  printf '%s\n' 'never: no skill registration :: \.claude/skills/' > "$AR"
  rm -f "$TMP/hits.log"
  runa 'hi' 'Bash
2026-01-01T00:00:00 never Fake :: forged' '{"command":"mkdir ~/.claude/skills/x"}' >/dev/null
  check "a newline in tool_name cannot forge log lines" \
    "$(wc -l < "$TMP/hits.log" | tr -d ' ')" 1
  check "an injected separator cannot skew stats" \
    "$("$RUL" stats | grep -c 'no skill registration')" 1

  printf '%s\n' 'never propose ship gates :: (ship|launch)[ -]?gate' > "$AR"
  printf '%s\n' 'ask: global npm installs need a yes :: npm install (-g|--global)' >> "$AR"
  check "test-action reports the mode" \
    "$("$RUL" test-action 'Bash
npm install -g x' | grep -c 'ask:')" 1
  check "test-action skips speech rulings" \
    "$("$RUL" test-action 'add a ship gate' | grep -c 'trips nothing')" 1

  echo
  echo "  ── rulings intake ──────────────────────────────────────"
  IN="$TMP/intake.txt"
  export HYGIENE_RULINGS="$IN"
  rm -f "$IN" "$TMP/hits.log"

  "$RUL" add-never 'skills are not registered' '\.claude/skills/' >/dev/null 2>&1
  check "add-never records a prefixed line" \
    "$(grep -c '^never: skills are not registered' "$IN")" 1
  "$RUL" add-never 'no skill registration' '\.claude/skills/' >/dev/null 2>&1
  check "duplicate regex exits 3" "$?" 3
  check "and writes nothing" "$(grep -c '^never:' "$IN")" 1
  OUT="$("$RUL" add-ask 'skills need a yes' '\.claude/skills/' 2>&1)"; rc=$?
  check "cross-mode collision exits 3" "$rc" 3
  check "report shows the prior ruling" \
    "$(printf '%s' "$OUT" | grep -c 'skills are not registered')" 1
  check "report shows the new ruling" \
    "$(printf '%s' "$OUT" | grep -c 'skills need a yes')" 1
  "$RUL" add-ask --force 'skills need a yes' '\.claude/skills/' >/dev/null 2>&1
  check "--force records anyway" "$(grep -c '^ask: skills need a yes' "$IN")" 1
  "$RUL" add-never 'no piping curl into sh' 'curl[^|]*\| *sh' >/dev/null 2>&1
  check "unrelated ruling records normally" \
    "$(grep -c '^never: no piping curl into sh' "$IN")" 1

  "$RUL" add-never 'match everything' '.*' >/dev/null 2>&1
  check "degenerate regex exits 3" "$?" 3
  mkdir -p "$TMP/projects/p1"
  python3 - "$TMP/projects/p1/s.jsonl" <<'PY'
import json,sys
rec = {"type":"assistant","message":{"role":"assistant","content":[
    {"type":"tool_use","name":"Bash","input":{"command":"brew install jq"}}]}}
with open(sys.argv[1],'w') as f:
    f.write(json.dumps(rec)+"\n")
    rec["message"]["content"][0]["input"]["command"] = "brew install ripgrep"
    f.write(json.dumps(rec)+"\n")
PY
  OUT="$("$RUL" add-never 'no unasked brew installs' 'brew install' 2>&1)"; rc=$?
  check "historically noisy regex exits 3" "$rc" 3
  check "with the would-have-fired count" \
    "$(printf '%s' "$OUT" | grep -c 'fired 2 times')" 1
  "$RUL" add-never 'no wiping system dirs' 'rm -rf /System' >/dev/null 2>&1
  check "quiet regex records" "$(grep -c '^never: no wiping system dirs' "$IN")" 1
  HYGIENE_PROJECTS_DIR="$TMP/absent-corpus" \
    "$RUL" add-never 'no sudo removals' 'sudo rm' >/dev/null 2>&1
  check "absent corpus still records" "$(grep -c '^never: no sudo removals' "$IN")" 1
  python3 - "$TMP/projects/p1/redos.jsonl" <<'PY'
import json,sys
rec = {"type":"assistant","message":{"role":"assistant","content":[
    {"type":"tool_use","name":"Bash","input":{"command":"a"*100}}]}}
open(sys.argv[1],'w').write(json.dumps(rec)+"\n")
PY
  "$RUL" add-never 'redos guard' '(a+)+b$' >/dev/null 2>&1
  check "regex too slow to evaluate exits 3" "$?" 3
else
  echo "  - python3 absent, skipping PreToolUse rulings tests"
fi

echo
echo "  ── controlled memory promotion ─────────────────────────"
if command -v python3 >/dev/null 2>&1; then
  MEMORY="$HYG/bin/memory"
  export HYGIENE_MEMORY_HOME="$TMP/memory-control"
  MID="$($MEMORY propose concept --project "$D" --text 'Cache keys include the locale.' \
        --evidence 'The implementation constructs locale-separated keys.' \
        --evidence-file seed.ts | awk '{print $2}')"
  check "candidate gets an opaque local id" \
    "$(printf '%s' "$MID" | grep -Ec '^[0-9a-f]{12}$')" 1
  check "proposal does not write project memory" \
    "$([ -e "$D/MEMORY.md" ] && echo wrote || echo quarantined)" quarantined
  check "review lists this project's candidate" \
    "$($MEMORY review --project "$D" | grep -c "$MID")" 1
  check "candidate is bound to its project" \
    "$($MEMORY show "$MID" --project "$TMP" >/dev/null 2>&1; echo $?)" 1

  $MEMORY approve "$MID" --project "$D" --to MEMORY.md >/dev/null 2>&1
  check "approval needs an explicit confirmation flag" "$?" 3
  APPROVAL="$($MEMORY approve "$MID" --project "$D" --to MEMORY.md --yes | \
              awk '/^approval /{print $2}')"
  check "approval is content-bound" \
    "$(printf '%s' "$APPROVAL" | grep -Ec '^[0-9a-f]{64}$')" 1
  $MEMORY promote "$MID" --project "$D" --approval "$APPROVAL" >/dev/null 2>&1
  check "approved candidate is promoted" "$?" 0
  check "promoted memory carries its immutable id" \
    "$(grep -c "hygiene-memory:$MID" "$D/MEMORY.md")" 1
  $MEMORY promote "$MID" --project "$D" --approval "$APPROVAL" >/dev/null 2>&1
  check "approval is single-use" "$?" 1

  EID="$($MEMORY propose concept --project "$D" --text 'The seed exports one value.' \
        --evidence 'The source artifact contains the export.' --evidence-file seed.ts | awk '{print $2}')"
  EAPP="$($MEMORY approve "$EID" --project "$D" --to MEMORY.md --yes | \
          awk '/^approval /{print $2}')"
  printf 'export const changed=2;\n' > "$D/seed.ts"
  $MEMORY promote "$EID" --project "$D" --approval "$EAPP" >/dev/null 2>&1
  check "changed evidence invalidates approval" "$?" 1

  $MEMORY propose concept --project "$D" --text 'The user wanted cache separation.' \
    --evidence 'A discussion happened.' >/dev/null 2>&1
  check "argument residue cannot enter quarantine" "$?" 1
  $MEMORY propose concept --project "$D" --text 'Keep this for the task.' \
    --evidence 'Temporary work.' --scope task >/dev/null 2>&1
  check "task state remains ephemeral" "$?" 1
  $MEMORY propose procedure --project "$D" --text 'Run the precision suite.' \
    --verify 'The summary reports zero failures.' >/dev/null 2>&1
  check "verifiable procedures can enter quarantine" "$?" 0
else
  echo "  - python3 absent, skipping controlled memory tests"
fi

echo
echo "  ── Claude layer install ────────────────────────────────"
if command -v python3 >/dev/null 2>&1; then
  CLAUDE_HOME="$TMP/claude-home"
  mkdir -p "$CLAUDE_HOME"
  HOME="$CLAUDE_HOME" "$HYG/install-claude" >/dev/null 2>&1
  check "installer ships the memory broker" \
    "$([ -x "$CLAUDE_HOME/.claude/hygiene/bin/memory" ] && echo yes || echo no)" yes
  check "installer disables immediate auto-memory publication" \
    "$(python3 - "$CLAUDE_HOME/.claude/settings.json" <<'PY'
import json,sys
print(json.load(open(sys.argv[1])).get("autoMemoryEnabled"))
PY
)" False
  HOME="$CLAUDE_HOME" "$HYG/install-claude" >/dev/null 2>&1
  check "Claude layer install remains idempotent" \
    "$(python3 - "$CLAUDE_HOME/.claude/settings.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); print(sum(
    1 for group in d["hooks"]["PreToolUse"] for h in group["hooks"]
    if h["command"].endswith("pretooluse-persistence.py")))
PY
)" 1
  check "default install has no response-retry Stop hook" \
    "$(python3 - "$CLAUDE_HOME/.claude/settings.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); print(sum(
    1 for group in d.get("hooks", {}).get("Stop", []) for h in group["hooks"]
    if h.get("command", "").endswith("stop-rulings.py")))
PY
)" 0
  RETRY_HOME="$TMP/claude-response-retries"
  mkdir -p "$RETRY_HOME"
  HOME="$RETRY_HOME" "$HYG/install-claude" --response-retries >/dev/null 2>&1
  check "response retries are explicitly installable" \
    "$(python3 - "$RETRY_HOME/.claude/settings.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); print(sum(
    1 for group in d["hooks"]["Stop"] for h in group["hooks"]
    if h.get("command", "").endswith("stop-rulings.py")))
PY
)" 1
  python3 - "$RETRY_HOME/.claude/settings.json" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p))
d["hooks"]["Stop"].append({"hooks":[{"type":"command","command":"/tmp/unrelated-stop"}]})
with open(p,"w") as f: json.dump(d,f)
PY
  HOME="$RETRY_HOME" "$HYG/install-claude" >/dev/null 2>&1
  check "default reinstall removes only Hygiene response retries" \
    "$(python3 - "$RETRY_HOME/.claude/settings.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); commands=[h.get("command","")
    for group in d["hooks"]["Stop"] for h in group["hooks"]]
print(commands == ["/tmp/unrelated-stop"])
PY
)" True
  check "installer registers one failed-commit guidance hook" \
    "$(python3 - "$CLAUDE_HOME/.claude/settings.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); print(sum(
    1 for group in d["hooks"]["PostToolUseFailure"] for h in group["hooks"]
    if h["command"].endswith("posttooluse-commit-failure.py")))
PY
)" 1
  POST="$HYG/claude/posttooluse-commit-failure.py"
  POST_MSG="$(printf '%s' '{"tool_name":"Bash","tool_input":{"command":"git commit -m test"}}' | python3 "$POST")"
  check "failed commit reminder forbids relocation" \
    "$(printf '%s' "$POST_MSG" | grep -c 'Relocating, rewording, unstaging')" 1
  check "failed commit reminder requires scan-first diagnosis" \
    "$(printf '%s' "$POST_MSG" | grep -c '\.githooks/scan')" 1
  check "unrelated failed commands receive no Hygiene reminder" \
    "$(printf '%s' '{"tool_name":"Bash","tool_input":{"command":"npm test"}}' | python3 "$POST" | wc -c | tr -d ' ')" 0
  HARD_HOME="$TMP/claude-hardened"
  mkdir -p "$HARD_HOME"
  HOME="$HARD_HOME" "$HYG/install-claude" --harden >/dev/null 2>&1
  check "hardened install enables fail-closed sandboxing" \
    "$(python3 - "$HARD_HOME/.claude/settings.json" <<'PY'
import json,sys
s=json.load(open(sys.argv[1]))["sandbox"]
print(s["enabled"] and s["failIfUnavailable"] and not s["allowUnsandboxedCommands"])
PY
)" True
  check "hardened install protects its control directory" \
    "$(python3 - "$HARD_HOME/.claude/settings.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); print(any(
    p.endswith("/.claude/hygiene") for p in d["sandbox"]["filesystem"]["denyWrite"]))
PY
)" True
else
  echo "  - python3 absent, skipping Claude install tests"
fi

echo
echo "  ── persistence hygiene — PreToolUse ────────────────────"
if command -v python3 >/dev/null 2>&1; then
  PERSIST="$HYG/claude/pretooluse-persistence.py"
  runp(){ mka "$1" "$2" "$3" | python3 "$PERSIST" >/dev/null 2>&1; \
          [ $? = 2 ] && printf 'block' || printf 'pass'; }

  # mkshown <assistant_msg> <user_msg> <tool> <input_json> — a transcript
  # where the assistant spoke first (e.g. quoted the proposed content), then
  # the user replied, mirroring an AskUserQuestion round trip.
  mkshown() {
    python3 - "$1" "$2" "$3" "$4" "$TMP/a.jsonl" <<'PY'
import json,sys
am,um,tn,ti,p = sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4],sys.argv[5]
with open(p,'w') as f:
    f.write(json.dumps({"type":"assistant","message":{"role":"assistant","content":am}})+"\n")
    f.write(json.dumps({"type":"user","message":{"role":"user","content":um}})+"\n")
print(json.dumps({"transcript_path":p,"tool_name":tn,"tool_input":json.loads(ti)}))
PY
  }
  runshown(){ mkshown "$1" "$2" "$3" "$4" | python3 "$PERSIST" >/dev/null 2>&1; \
          [ $? = 2 ] && printf 'block' || printf 'pass'; }

  check "ordinary source writes pass" \
    "$(runp 'implement it' Write '{"file_path":"/p/app.ts","content":"export const user = wanted;"}')" pass
  check "product prose stays exempt" \
    "$(runp 'update the copy' Write '{"file_path":"/p/content/story.md","content":"The user wanted a faster checkout."}')" pass
  check "impersonal project prose passes" \
    "$(runp 'document the cache' Write '{"file_path":"/p/notes.md","content":"Cache keys include the locale."}')" pass
  check "argument residue in project prose blocks" \
    "$(runp 'document the cache' Write '{"file_path":"/p/notes.md","content":"The user rejected caching after we argued about it."}')" block
  check "an explicit request cannot preserve an argument" \
    "$(runp 'write that the user rejected caching' Write '{"file_path":"/p/notes.md","content":"The user rejected caching after the discussion."}')" block

  check "unsolicited memory writes block" \
    "$(runp 'finish the implementation' Write '{"file_path":"/p/MEMORY.md","content":"Cache keys include the locale."}')" block
  check "relative auto-memory paths also block" \
    "$(runp 'finish the implementation' Write '{"file_path":".claude/memory/cache.md","content":"Cache keys include the locale."}')" block
  check "structured prose cannot bypass review" \
    "$(runp 'finish the implementation' Write '{"file_path":"/p/MEMORY.md","content":"Concept: Cache keys include the locale.\nEvidence: The cache-key test asserts locale separation."}')" block
  check "a requested direct memory write is now authorized" \
    "$(runp 'please add this to memory: cache keys include the locale' Write '{"file_path":"/p/MEMORY.md","content":"Cache keys include the locale."}')" pass
  check "a bare yes without shown content still blocks" \
    "$(runp 'yes' Write '{"file_path":"/p/MEMORY.md","content":"Cache keys include the locale."}')" block
  check "yes approving exactly what was shown passes" \
    "$(runshown 'Proposed: Cache keys include the locale.' 'Yes, add as written' Write '{"file_path":"/p/MEMORY.md","content":"Cache keys include the locale."}')" pass
  check "yes approving different content than what was shown still blocks" \
    "$(runshown 'Proposed: cache keys are per-tenant.' 'Yes, add as written' Write '{"file_path":"/p/MEMORY.md","content":"Cache keys include the locale."}')" block
  check "old residue can be removed" \
    "$(runp 'clean the note' Edit '{"file_path":"/p/notes.md","old_string":"The user rejected caching.","new_string":"Cache keys include the locale."}')" pass

  check "a requested location-free handoff passes" \
    "$(runp 'write the handoff' Edit '{"file_path":"/p/CONTEXT.md","old_string":"old","new_string":"## Next\nConfirm the removal path still passes."}')" pass
  check "a handoff containing a path blocks" \
    "$(runp 'write the handoff' Edit '{"file_path":"/p/CONTEXT.md","old_string":"old","new_string":"## Next\nContinue in /Volumes/Elsewhere/app.ts."}')" block
  check "an unsolicited handoff write blocks" \
    "$(runp 'finish the feature' Write '{"file_path":"/p/CONTEXT.md","content":"## Next\nContinue the unfinished check."}')" block

  check "residue written through Bash blocks" \
    "$(runp 'document it' Bash '{"command":"printf %s \\\"the user wanted blue\\\" > notes.md"}')" block
  check "residue cannot be moved into a skill through Bash" \
    "$(runp 'write the skill' Bash '{"command":"printf %s \\\"the user asked, then I corrected it\\\" > ~/.claude/skills/example/SKILL.md"}')" block
  check "reading prose through Bash passes" \
    "$(runp 'inspect it' Bash '{"command":"grep -n \\\"the user wanted\\\" notes.md"}')" pass
  check "candidate proposal command passes" \
    "$(runp 'capture this as a candidate' Bash '{"command":"hygiene memory propose concept --text fact --evidence test"}')" pass
  check "generic consent cannot approve a candidate" \
    "$(runp 'yes' Bash '{"command":"hygiene memory approve abcdef123456 --to MEMORY.md --yes"}')" block
  check "candidate-specific consent permits approval broker" \
    "$(runp 'approve candidate abcdef123456' Bash '{"command":"hygiene memory approve abcdef123456 --to MEMORY.md --yes"}')" pass
  check "direct broker path still needs candidate consent" \
    "$(runp 'yes' Bash '{"command":"~/.claude/hygiene/bin/memory promote abcdef123456 --approval aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}')" block
  check "direct edits to broker state block" \
    "$(runp 'change it' Write '{"file_path":"/u/.claude/hygiene/memory-control/candidates/x.json","content":"{}"}')" block

  export HYGIENE_RULINGS="/p/rulings.txt"
  check "the rulings file remains owned by rulings intake" \
    "$(runp 'record the ruling' Write '{"file_path":"/p/rulings.txt","content":"the user decided this"}')" pass
  printf 'not json' | python3 "$PERSIST" >/dev/null 2>&1
  check "persistence hook fails open on malformed input" "$?" 0
else
  echo "  - python3 absent, skipping persistence hygiene tests"
fi

echo
echo "  ── governance hygiene — Claude PreToolUse ──────────────"
PRE_HYG="$HYG/claude/pretooluse-hygiene.sh"
runh(){ printf '%s' "$1" | "$PRE_HYG" >/dev/null 2>&1; \
        [ $? = 2 ] && printf 'block' || printf 'pass'; }
check "Claude hook permits an ISO date in source data" \
  "$(runh '{"tool_name":"Write","tool_input":{"file_path":"/p/app.ts","content":"export const date = \\\"2026-09-01\\\";"}}')" pass
check "Claude hook permits a dated test fixture" \
  "$(runh '{"tool_name":"Write","tool_input":{"file_path":"/p/tests/date.ts","content":"// Fixture boundary 2026-09-01"}}')" pass
check "Claude hook permits a descriptive production incident date" \
  "$(runh '{"tool_name":"Write","tool_input":{"file_path":"/p/app.ts","content":"// Incident snapshot 2026-09-01"}}')" pass
check "Claude hook still blocks actual governance beside a date" \
  "$(runh '{"tool_name":"Write","tool_input":{"file_path":"/p/app.ts","content":"// Owner ruling 2026-09-01: never change this file"}}')" block
check "Claude hook permits a warning glyph in a data literal" \
  "$(runh '{"tool_name": "Write", "tool_input": {"file_path": "/p/menu.ts", "content": "const ICONS = {\n  '"'"'/disclaimer'"'"': '"'"'⚠️'"'"',\n}\n"}}')" pass
check "Claude hook still blocks a warning glyph in a comment banner" \
  "$(runh '{"tool_name": "Write", "tool_input": {"file_path": "/p/app.ts", "content": "// ⚠️ banner\nexport const a = 1\n"}}')" block

# A glyph is governance in a comment banner and ordinary content anywhere else.
# The scanner reads comment lines alone; this hook says "source comment" in its
# own refusal, so it has to judge the same lines.

echo
echo "  ── labeled benchmark ───────────────────────────────────"
# The corpus is hand-labeled, so these checks are about the corpus and the
# harness rather than about the detector. The detector itself is measured by
# the benchmark, not asserted here.
BM="$HYG/benchmark"
. "$HYG/lib/rules.sh"
UNKNOWN="$(awk -F'\t' '/^#/ || NF < 3 { next }
    { n = split($2, a, ","); for (i = 1; i <= n; i++)
        if (a[i] != "" && a[i] != "clean") print a[i] }' "$BM/cases.tsv" \
  | sort -u | while IFS= read -r r; do
      printf '%s\n' "$HYG_RULES" | grep -qx "$r" || printf '%s\n' "$r"; done)"
check "every labeled rule is registered" "$UNKNOWN" ""
N="$(awk -F'\t' '/^#/ || NF < 3 { next } { n++ } END { print n + 0 }' "$BM/cases.tsv")"
check "the corpus is at least 120 cases" "$([ "$N" -ge 120 ] && printf yes || printf no)" yes
MISSING="$(awk -F'\t' '/^#/ || NF < 3 { next } { print $3 }' "$BM/cases.tsv" | sort -u \
  | while IFS= read -r p; do [ -f "$BM/cases/$p" ] || printf '%s\n' "$p"; done)"
check "every labeled case has a fixture" "$MISSING" ""

"$BM/run" >/dev/null 2>&1
check "the benchmark meets the release gate" "$?" 0
"$BM/run" --format md > "$TMP/bench.md" 2>/dev/null
diff -q "$TMP/bench.md" "$BM/RESULTS.md" >/dev/null 2>&1
check "the published result is generated, not edited" "$?" 0
check "CI runs the benchmark" "$(grep -c '\./benchmark/run' "$HYG/.github/workflows/ci.yml")" 1
check "CI runs every suite this file runs" \
  "$(for c in test/run benchmark/run test/self-scan; do
       grep -q "\./$c" "$HYG/.github/workflows/ci.yml" || printf '%s ' "$c"; done | wc -w | tr -d ' ')" 0

# A label the corpus does not support has to fail the gate, or the gate is
# decoration. The tampered copy keeps the detector and changes only labels.
TAMBM="$TMP/bmroot"; guard "$TAMBM"; mkdir -p "$TAMBM"
cp -R "$BM" "$TAMBM/benchmark"; ln -s "$HYG/lib" "$TAMBM/lib"
awk -F'\t' -v OFS='\t' '/^#/ || NF < 3 { print; next }
  $2 == "HYG-GOV-001" { $2 = "HYG-PHA-001" } { print }' \
  "$BM/cases.tsv" > "$TAMBM/benchmark/cases.tsv"
"$TAMBM/benchmark/run" >/dev/null 2>&1
check "labels the corpus does not support fail the gate" "$?" 1

echo
echo "  ── structured output ───────────────────────────────────"
# A document on stdout has to be the whole document, and it has to be a valid
# one. These checks parse with python rather than grep, so a stray banner line
# or a broken escape fails here instead of in someone's CI parser.
FMT="$TMP/fmt"; guard "$FMT"; mkdir -p "$FMT/src"
{
  echo '// Owner ruling: NEVER change this flow. See OLD-DESIGN.md'
  echo '// This module is the compatibility shim for the old pricing pipeline.'
  echo '// It has to keep working for tenants that have not migrated, so the'
  echo '// shape of its output is part of the contract and cannot be changed'
  echo '// without a migration on the tenant side. Every branch below exists'
  echo '// because of a tenant that is still on the old plan, and the count'
  echo '// only goes down as tenants move across.'
  echo 'export const a = 1;'
  for i in $(seq 1 40); do echo "export const k$i = $i;"; done
  echo '// The user rejected this approach twice.'
} > "$FMT/src/legacy.ts"
printf '// do not edit this file\n' > "$FMT/src/plain.ts"

"$HYG/bin/scan" --format json "$FMT" > "$FMT/out.json" 2>"$FMT/out.err"
check "json exits 0" "$?" 0
check "json leaves stderr empty" "$(wc -l < "$FMT/out.err" | tr -d ' ')" 0
python3 - "$FMT/out.json" <<'PYEOF' && ok "json parses" || bad "json parses"
import json, sys
d = json.load(open(sys.argv[1]))
assert d["schemaVersion"] == 1, d.get("schemaVersion")
assert d["tool"]["name"] == "hygiene"
assert isinstance(d["root"], str) and d["root"]
assert d["summary"]["findings"] == len(d["findings"])
rules = {f["ruleId"] for f in d["findings"]}
assert "HYG-GOV-001" in rules, rules
assert "HYG-ARG-001" in rules, rules
assert "HYG-PHA-001" in rules, rules
for f in d["findings"]:
    assert set(f) == {"ruleId","category","severity","file","line","match",
                      "fingerprint","message","remediation","evidence"}, set(f)
    assert f["severity"] in ("warning", "info"), f["severity"]
    assert f["fingerprint"].startswith(f["ruleId"] + ":"), f["fingerprint"]
    assert f["line"] is None or isinstance(f["line"], int)
PYEOF

python3 - "$FMT/out.json" <<'PYEOF' && ok "volume finding has a null line and a file fingerprint" || bad "volume finding shape"
import json, sys
d = json.load(open(sys.argv[1]))
vol = [f for f in d["findings"] if f["ruleId"] == "HYG-VOL-001"]
assert vol, "expected a comment-volume finding"
for v in vol:
    assert v["line"] is None and v["match"] is None, v
    assert v["fingerprint"].split(":")[1] == "p", v["fingerprint"]
PYEOF

"$HYG/bin/scan" --format sarif "$FMT" > "$FMT/out.sarif" 2>"$FMT/sarif.err"
check "sarif exits 0" "$?" 0
check "sarif leaves stderr empty" "$(wc -l < "$FMT/sarif.err" | tr -d ' ')" 0
python3 - "$FMT/out.sarif" <<'PYEOF' && ok "sarif parses and is structurally sound" || bad "sarif structure"
import json, sys
d = json.load(open(sys.argv[1]))
assert d["version"] == "2.1.0", d["version"]
assert d["$schema"].endswith("sarif-2.1.0.json"), d["$schema"]
runs = d["runs"]
assert len(runs) == 1, len(runs)
run = runs[0]
drv = run["tool"]["driver"]
assert drv["name"] == "hygiene" and drv["version"]
ids = [r["id"] for r in drv["rules"]]
assert len(ids) == len(set(ids)), "duplicate rule descriptor"
assert run["results"], "expected results"
for r in run["results"]:
    assert r["ruleIndex"] == ids.index(r["ruleId"]), r
    assert drv["rules"][r["ruleIndex"]]["name"].isalnum(), r
    assert r["level"] in ("warning", "note"), r
    loc = r["locations"][0]["physicalLocation"]
    assert loc["artifactLocation"]["uri"], r
    assert r["partialFingerprints"]["hygieneFingerprint/v1"].startswith(r["ruleId"] + ":"), r
    if "region" in loc:
        assert isinstance(loc["region"]["startLine"], int), r
# a file-level finding must not invent a line
vol = [r for r in run["results"] if r["ruleId"] == "HYG-VOL-001"]
assert vol and all("region" not in r["locations"][0]["physicalLocation"] for r in vol), vol
PYEOF

python3 - "$FMT/out.json" "$FMT/out.sarif" <<'PYEOF' && ok "the two formats agree on every finding" || bad "format agreement"
import json, sys
j = json.load(open(sys.argv[1])); s = json.load(open(sys.argv[2]))
jf = sorted((f["ruleId"], f["file"], f["line"], f["fingerprint"]) for f in j["findings"])
sf = sorted((r["ruleId"],
             r["locations"][0]["physicalLocation"]["artifactLocation"]["uri"],
             r["locations"][0]["physicalLocation"].get("region", {}).get("startLine"),
             r["partialFingerprints"]["hygieneFingerprint/v1"]) for r in s["runs"][0]["results"])
assert jf == sf, (jf, sf)
PYEOF

check "an unknown format is a usage error" \
  "$("$HYG/bin/scan" --format yaml "$FMT" >/dev/null 2>&1; echo $?)" 2
check "an unknown option is a usage error" \
  "$("$HYG/bin/scan" --nope "$FMT" >/dev/null 2>&1; echo $?)" 2
check "help exits 0"  "$("$HYG/bin/scan" --help >/dev/null 2>&1; echo $?)" 0
check "a missing path is a usage error" \
  "$("$HYG/bin/scan" --format json "$TMP/no-such-dir" >/dev/null 2>&1; echo $?)" 2

# The text report is the default and has not moved: same first line, same
# finding count, whether or not a format flag exists.
DEFAULT="$("$HYG/bin/scan" "$FMT" 2>/dev/null | sed -n '2p')"
EXPLICIT="$("$HYG/bin/scan" --format text "$FMT" 2>/dev/null | sed -n '2p')"
check "text is still the default" "$DEFAULT" "$EXPLICIT"
check "text output carries no JSON" \
  "$("$HYG/bin/scan" "$FMT" 2>/dev/null | grep -c 'schemaVersion')" 0

echo
echo "  ── arbitrary filenames and matched text ────────────────"
# Matched text comes from source files and can hold anything a file holds.
# A quote or a newline in a match must not be able to end a JSON string, and a
# space in a path must not turn into two SARIF locations.
ODD="$TMP/odd"; guard "$ODD"; mkdir -p "$ODD/src"
printf '%s\n' '// Owner ruling: NEVER change this flow' > "$ODD/src/a file \"quoted\".ts"
printf '%s\n' '// never edit this file'"$(printf '\t')"'today' > "$ODD/src/tabs.ts"
printf '%s\n' '// owner corrected this twice: use backslash \ here' > "$ODD/src/slash.ts"
"$HYG/bin/scan" --format json "$ODD" > "$ODD/o.json" 2>/dev/null
python3 - "$ODD/o.json" <<'PYEOF' && ok "a quote, a tab and a backslash survive the round trip" || bad "escaping"
import json, sys
d = json.load(open(sys.argv[1]))
files = [f["file"] for f in d["findings"]]
assert any('quoted' in f for f in files), files
assert any(f == "src/tabs.ts" for f in files), files
assert any("backslash" in (f["evidence"] or "") for f in d["findings"]), d["findings"]
PYEOF
"$HYG/bin/scan" --format sarif "$ODD" > "$ODD/o.sarif" 2>/dev/null
python3 - "$ODD/o.sarif" <<'PYEOF' && ok "a space in a filename becomes a percent-encoded URI" || bad "uri encoding"
import json, sys
d = json.load(open(sys.argv[1]))
uris = [r["locations"][0]["physicalLocation"]["artifactLocation"]["uri"]
        for r in d["runs"][0]["results"]]
assert any("%20" in u for u in uris), uris
assert not any(" " in u for u in uris), uris
PYEOF

echo
echo "  ── baselines ───────────────────────────────────────────"
BL="$TMP/bl"; guard "$BL"; mkdir -p "$BL/src"
printf '%s\n' '// Owner ruling: NEVER change this flow' 'export const a = 1;' > "$BL/src/one.ts"
{
  for i in 1 2 3 4 5 6 7 8; do echo "// explanatory line $i about the shim"; done
  for i in $(seq 1 40); do echo "export const k$i = $i;"; done
} > "$BL/src/vol.ts"

"$HYG/bin/scan" --write-baseline "$BL" >/dev/null 2>"$BL/write.err"
check "write-baseline exits 0" "$?" 0
check "write-baseline says what it wrote" \
  "$(grep -c 'wrote 2 findings to' "$BL/write.err")" 1
# Recording a baseline still prints the report it recorded: seeing exactly
# what you just froze is the point. Only the confirmation goes to stderr.
check "write-baseline prints the report it recorded" \
  "$("$HYG/bin/scan" --write-baseline "$BL" 2>/dev/null | sed -n '2p')" \
  "$("$HYG/bin/scan" "$BL" 2>/dev/null | sed -n '2p')"
check "the baseline lands where it says" "$([ -f "$BL/.hygiene-baseline" ] && echo yes)" yes
check "the baseline declares its schema" \
  "$(head -1 "$BL/.hygiene-baseline")" "# hygiene baseline: schema 1"

check "--new with no baseline is an error" \
  "$("$HYG/bin/scan" --new "$TMP/fmt" >/dev/null 2>&1; echo $?)" 2
check "--new and --write-baseline together are an error" \
  "$("$HYG/bin/scan" --new --write-baseline "$BL" >/dev/null 2>&1; echo $?)" 2

check "--new suppresses everything it recorded" "$(scan_count --new "$BL")" 0
check "--new still reports the suppressed count" \
  "$("$HYG/bin/scan" --new "$BL" 2>/dev/null | grep -c '2 findings suppressed by')" 1

# A genuinely new finding is reported, and only it.
printf '%s\n' '// never touch this module' > "$BL/src/two.ts"
NEWOUT="$("$HYG/bin/scan" --new "$BL" 2>/dev/null)"
check "--new reports a genuinely new finding" \
  "$(printf '%s' "$NEWOUT" | grep -c 'two.ts')" 1
check "--new still hides the baselined one" \
  "$(printf '%s' "$NEWOUT" | grep -c 'one.ts')" 0
check "--new counts only the new finding" "$(scan_count --new "$BL")" 1
rm "$BL/src/two.ts"

# A line finding is matched by its text, so moving the file and moving the line
# do not make it new. This is the property that makes a baseline usable in a
# repository that is still being edited.
mv "$BL/src/one.ts" "$BL/src/renamed-one.ts"
check "--new does not re-report a moved line finding" "$(scan_count --new "$BL")" 0
{ echo 'export const pad = 1;'; echo 'export const pad2 = 2;'; cat "$BL/src/renamed-one.ts"; } > "$BL/src/pad.tmp"
mv "$BL/src/pad.tmp" "$BL/src/renamed-one.ts"
check "--new does not re-report a shifted line finding" "$(scan_count --new "$BL")" 0

# Rewording the matched line does make it new. The text is what the rule is
# about, so a baseline that survived a rewrite would be hiding a change.
sed 's/NEVER change this flow/NEVER change this flow or its tests/' \
  "$BL/src/renamed-one.ts" > "$BL/src/rw.tmp"
mv "$BL/src/rw.tmp" "$BL/src/renamed-one.ts"
check "--new reports a reworded finding as new" \
  "$("$HYG/bin/scan" --new "$BL" 2>/dev/null | grep -c 'renamed-one.ts')" 1

# The text report and the structured formats are filtered by the same
# comparison, so they cannot disagree about what is new.
"$HYG/bin/scan" --new --format json "$BL" > "$BL/n.json" 2>/dev/null
check "text --new and json --new agree" "$(scan_count --new "$BL")" \
  "$(python3 -c "import json;print(len(json.load(open('$BL/n.json'))['findings']))")"
python3 - "$BL/n.json" <<'PYEOF' && ok "json --new carries the baseline it used" || bad "json baseline field"
import json, sys
d = json.load(open(sys.argv[1]))
b = d["baseline"]
assert b["path"] == ".hygiene-baseline", b
assert b["schemaVersion"] == 1, b
assert b["suppressed"] == 1, b
assert d["summary"]["findings"] == len(d["findings"])
PYEOF

# Deleting the finding leaves a stale row, which is inert: it matches nothing
# and is not rewritten behind your back.
rm "$BL/src/renamed-one.ts"
check "--new after the finding is deleted reports clean" "$(scan_count --new "$BL")" 0
check "baseline rows survive a finding disappearing" \
  "$(grep -c 'HYG-GOV-001' "$BL/.hygiene-baseline" | tr -d ' ')" 1

# A whole-file finding is keyed on the path, so a move reports it once. That is
# the documented cost of having no line to hash.
mv "$BL/src/vol.ts" "$BL/src/renamed-vol.ts"
check "--new re-reports a moved file-level finding once" "$(scan_count --new "$BL")" 1
mv "$BL/src/renamed-vol.ts" "$BL/src/vol.ts"
check "--new is clean again once the path is back" "$(scan_count --new "$BL")" 0

# A baseline from a different schema is rejected rather than misread.
SCHEMA_BL="$TMP/schema-bl"; guard "$SCHEMA_BL"; mkdir -p "$SCHEMA_BL"
cp -R "$BL/src" "$SCHEMA_BL/src"
sed 's/schema 1/schema 99/' "$BL/.hygiene-baseline" > "$SCHEMA_BL/.hygiene-baseline"
check "a foreign baseline schema is an error" \
  "$("$HYG/bin/scan" --new "$SCHEMA_BL" >/dev/null 2>&1; echo $?)" 2
check "a foreign baseline schema says why" \
  "$("$HYG/bin/scan" --new "$SCHEMA_BL" 2>&1 >/dev/null | grep -c 'schema')" 1

# A baseline is a filter, not a mode: without --new it is inert.
check "a plain scan ignores a baseline that exists" \
  "$(scan_count "$BL")" 1

# --baseline takes a path, resolved against the scanned root the way
# .hygieneignore is, so a baseline stored elsewhere still works.
mv "$BL/.hygiene-baseline" "$TMP/elsewhere.baseline"
check "--baseline accepts an explicit path" \
  "$("$HYG/bin/scan" --new --baseline "$TMP/elsewhere.baseline" "$BL" >/dev/null 2>&1; echo $?)" 0
check "--baseline reports the path it used" \
  "$("$HYG/bin/scan" --new --baseline "$TMP/elsewhere.baseline" "$BL" 2>/dev/null | grep -c 'elsewhere.baseline')" 1
check "a missing explicit baseline is an error" \
  "$("$HYG/bin/scan" --new --baseline "$TMP/no.baseline" "$BL" >/dev/null 2>&1; echo $?)" 2

echo "  ── strict ──────────────────────────────────────────────"
# --strict is the one thing that makes the scan fail a build, so the tests are
# mostly about what it does NOT fail: an informational finding is reported and
# the run stays green, and without the flag nothing changes at all.
ST="$TMP/strict"; guard "$ST"; mkdir -p "$ST/src"
printf '%s\n' '// Owner ruling: NEVER change this flow' 'export const a = 1;' > "$ST/src/one.ts"
{
  for i in 1 2 3 4 5 6 7 8; do echo "// explanatory line $i about the shim"; done
  for i in $(seq 1 40); do echo "export const k$i = $i;"; done
} > "$ST/src/vol.ts"

check "a plain scan of a warning tree still exits 0" \
  "$("$HYG/bin/scan" "$ST" >/dev/null 2>&1; echo $?)" 0
check "--strict exits 1 on a warning" \
  "$("$HYG/bin/scan" --strict "$ST" >/dev/null 2>&1; echo $?)" 1
check "--strict says how many warnings failed it" \
  "$("$HYG/bin/scan" --strict "$ST" 2>&1 >/dev/null | grep -c '1 warning finding')" 1
check "--strict fails the structured report too" \
  "$("$HYG/bin/scan" --strict --format json "$ST" >/dev/null 2>&1; echo $?)" 1
check "--strict does not change the report it prints" \
  "$("$HYG/bin/scan" --strict "$ST" 2>/dev/null | cksum)" "$("$HYG/bin/scan" "$ST" 2>/dev/null | cksum)"

# The severity split is the whole point: a size signal is not a defect, so an
# informational finding is reported and does not fail the run.
STINFO="$TMP/strict-info"; guard "$STINFO"; mkdir -p "$STINFO"
cp "$ST/src/vol.ts" "$STINFO/vol.ts"
check "the info fixture holds exactly one informational finding" \
  "$("$HYG/bin/scan" --format json "$STINFO" 2>/dev/null | python3 -c '
import json,sys; d=json.load(sys.stdin)
print("%d/%d" % (d["summary"]["info"], d["summary"]["warning"]))')" "1/0"
check "--strict stays green on informational findings only" \
  "$("$HYG/bin/scan" --strict "$STINFO" >/dev/null 2>&1; echo $?)" 0
STCLEAN="$TMP/strict-clean"; guard "$STCLEAN"; mkdir -p "$STCLEAN"
printf '%s\n' 'export const a = 1;' > "$STCLEAN/plain.ts"
check "--strict stays green on a clean tree" \
  "$("$HYG/bin/scan" --strict "$STCLEAN" >/dev/null 2>&1; echo $?)" 0

# --strict gates what the run reports, not what the tree contains, so a finding
# the baseline already covers cannot fail a build a second time.
"$HYG/bin/scan" --write-baseline "$ST" >/dev/null 2>&1
check "--strict is green once the warnings are baselined" \
  "$("$HYG/bin/scan" --new --strict "$ST" >/dev/null 2>&1; echo $?)" 0
check "--strict still fails on a warning the baseline does not hold" \
  "$(printf '%s\n' '// Do not edit this file' >> "$ST/src/vol.ts"; \
     "$HYG/bin/scan" --new --strict "$ST" >/dev/null 2>&1; echo $?)" 1
rm -f "$ST/.hygiene-baseline"

# A usage error is still a usage error, and is not downgraded to 1.
check "--strict does not hide a usage error" \
  "$("$HYG/bin/scan" --strict --format yaml "$ST" >/dev/null 2>&1; echo $?)" 2
check "--strict does not hide a missing path" \
  "$("$HYG/bin/scan" --strict "$TMP/no-such-dir" >/dev/null 2>&1; echo $?)" 2
check "--strict is listed in the usage text" \
  "$("$HYG/bin/scan" --help 2>/dev/null | grep -c -- '--strict')" 2

echo "  ── explain ─────────────────────────────────────────────"
check "explain lists every rule" \
  "$("$HYG/bin/explain" 2>/dev/null | grep -c '^  HYG-')" "$(printf '%s\n' "$HYG_RULES" | grep -c .)"
check "explain takes a rule id" \
  "$("$HYG/bin/explain" HYG-PHA-001 2>/dev/null | grep -c 'what it does not claim')" 1
check "explain rejects an unknown rule" \
  "$("$HYG/bin/explain" HYG-NOPE-001 >/dev/null 2>&1; echo $?)" 2
check "explain exits 2 with nothing" \
  "$("$HYG/bin/explain" a b >/dev/null 2>&1; echo $?)" 2
check "hygiene explain dispatches" \
  "$("$HYG/bin/hygiene" explain HYG-ARG-002 2>/dev/null | grep -c 'HYG-ARG-002')" 1

echo
echo "  ── the installed scanner still works ───────────────────"
# The scanner was split into lib/ files. An installer that copies only some of
# them produces a scanner that finds nothing and reports success, which is the
# worst possible failure for this tool.
INST="$(newrepo installed-libs)"
printf '%s\n' '// Owner ruling: NEVER change this file' > "$INST/flag.ts"
check "installed scan still finds findings" \
  "$("$INST/.githooks/scan" "$INST" 2>/dev/null | grep -c 'flag.ts')" 1
check "installed scan emits valid json" \
  "$("$INST/.githooks/scan" --format json "$INST" 2>/dev/null | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["findings"]))')" 1
# The installed scanner reads the surface table as well as the libraries: it
# answers which files carry import syntax, so a copy without the table reports
# no findings from that carrier and still exits 0. The check below reads a
# memory file with an import that does not resolve, which is the finding the
# table decides.
printf '%s\n' 'Read @docs/absent.md before you start.' > "$INST/AGENTS.md"
check "installed scan reads the carrier the surface table names" \
  "$("$INST/.githooks/scan" "$INST" 2>/dev/null | grep -c 'docs/absent.md')" 1
check "install copies every library and table the scanner reads" \
  "$(for l in patterns.sh references.sh rules.sh findings.sh report.sh exposure-surfaces.tsv; do
       [ -f "$INST/.githooks/lib/$l" ] || echo "missing-$l"
     done | wc -l | tr -d ' ')" 0

echo
echo "  ── context exposure ────────────────────────────────────"
# This command answers a question about a path in a repository. It never claims
# an agent read anything, so a file it wrongly calls loaded is the worst bug it
# can have. The fixture below puts one file on each documented surface and
# several on none, and most of the checks are about the ones that must come out
# unknown.
EXP="$TMP/exposure"; guard "$EXP"
mkdir -p "$EXP/src" "$EXP/docs" "$EXP/notes" "$EXP/sub" \
         "$EXP/.claude/rules" "$EXP/.cursor/rules" "$EXP/.github/instructions"

printf 'See @docs/notes.md.\n' > "$EXP/CLAUDE.md"
printf 'Project instructions.\n' > "$EXP/AGENTS.md"
printf 'The owner rejected this approach twice.\n' > "$EXP/sub/AGENTS.md"
printf -- '---\npaths:\n  - "src/**"\n---\nA scoped rule.\n' > "$EXP/.claude/rules/scoped.md"
printf 'A rule with no frontmatter.\n' > "$EXP/.claude/rules/plain.md"
printf -- '---\npaths:\n  - "src/**"\nNever closed.\n' > "$EXP/.claude/rules/broken.md"
printf -- '---\nalwaysApply: true\n---\nAlways.\n' > "$EXP/.cursor/rules/always.mdc"
printf -- '---\nglobs: src/**\n---\nGlobbed.\n' > "$EXP/.cursor/rules/globs.mdc"
printf -- '---\ndescription: something\n---\nDescribed.\n' > "$EXP/.cursor/rules/described.mdc"
printf -- '---\nglobs: src/**\nNever closed.\n' > "$EXP/.cursor/rules/broken.mdc"
printf 'Repository instructions.\n' > "$EXP/.github/copilot-instructions.md"
printf -- '---\napplyTo: "**/*.ts"\n---\nTypescript.\n' > "$EXP/.github/instructions/ts.instructions.md"
printf 'No pattern here.\n' > "$EXP/.github/instructions/plain.instructions.md"

# Three findings, one for each verdict. The prose files carry the same sentence,
# so the only thing that separates them is where they sit.
printf 'The owner rejected this approach twice.\n' > "$EXP/docs/notes.md"
printf 'The owner rejected this approach twice.\n' > "$EXP/notes/memory.md"
printf '// Owner ruling: NEVER change this flow.\n' > "$EXP/src/legacy.ts"
printf 'export const a = 1;\n' > "$EXP/src/plain.ts"

expsurface() {
  "$HYG/bin/exposure" --tool "$1" --format json "$2" 2>/dev/null \
    | python3 -c '
import json, sys
want = sys.argv[1]
for f in json.load(sys.stdin)["surfaces"]["files"]:
    if f["path"] == want:
        print(f["surface"]); break
else:
    print("not-listed")' "$3"
}
expverdict() {
  "$HYG/bin/exposure" --tool "$1" --format json "$2" 2>/dev/null \
    | python3 -c '
import json, sys
want = sys.argv[1]
for f in json.load(sys.stdin)["findings"]:
    if f["file"] == want:
        print(f["exposure"]); break
else:
    print("no-finding")' "$3"
}

check "a root instruction file is automatic" \
  "$(expsurface claude-code "$EXP" CLAUDE.md)" automatic
check "a nested instruction file is configured" \
  "$(expsurface claude-code "$EXP" sub/AGENTS.md)" configured
# Two instruction files in one directory is a real conflict, and the tool
# documents which one stops loading. The displaced file is still listed: it is
# the answer a reader came for, not an absence of information.
check "a displaced instruction file is unknown, not automatic" \
  "$(expsurface claude-code "$EXP" AGENTS.md)" unknown
check "a displaced instruction file is still reported" \
  "$("$HYG/bin/exposure" --tool claude-code "$EXP" 2>/dev/null | grep -c '^    unknown     AGENTS.md ')" 1
check "the same file is automatic for a tool with no displacer" \
  "$(expsurface codex "$EXP" AGENTS.md)" automatic

check "a claude rule scoped by a paths field is configured" \
  "$(expsurface claude-code "$EXP" .claude/rules/scoped.md)" configured
check "a claude rule with no paths field is automatic" \
  "$(expsurface claude-code "$EXP" .claude/rules/plain.md)" automatic
# The documented fallback for frontmatter that cannot be parsed is to load the
# rule unscoped, so this one is reported as loading rather than as unknown.
check "unreadable claude frontmatter falls back to loading" \
  "$(expsurface claude-code "$EXP" .claude/rules/broken.md)" automatic

check "an alwaysApply cursor rule is automatic" \
  "$(expsurface cursor "$EXP" .cursor/rules/always.mdc)" automatic
check "a globbed cursor rule is configured" \
  "$(expsurface cursor "$EXP" .cursor/rules/globs.mdc)" configured
check "a cursor rule the agent must pick is unknown" \
  "$(expsurface cursor "$EXP" .cursor/rules/described.mdc)" unknown
check "unreadable cursor frontmatter is unknown" \
  "$(expsurface cursor "$EXP" .cursor/rules/broken.mdc)" unknown

check "the copilot instruction file is automatic" \
  "$(expsurface copilot "$EXP" .github/copilot-instructions.md)" automatic
check "a copilot instruction with applyTo is configured" \
  "$(expsurface copilot "$EXP" .github/instructions/ts.instructions.md)" configured
# applyTo is what scopes this file. Reporting it as loading because it happens
# to sit in the right directory would be the claim this tool exists to avoid.
check "a copilot instruction without applyTo is unknown" \
  "$(expsurface copilot "$EXP" .github/instructions/plain.instructions.md)" unknown
check "a root instruction file is an alternative when another is present" \
  "$(expsurface copilot "$EXP" CLAUDE.md)" unknown

# The negative case the whole feature rests on: a file whose name suggests
# memory, holding the same prose, on no documented surface, is not exposed.
check "a memory-shaped file nothing documents is not listed" \
  "$(expsurface claude-code "$EXP" notes/memory.md)" not-listed
check "a memory-shaped file nothing documents is stored" \
  "$(expverdict claude-code "$EXP" notes/memory.md)" stored
check "an ordinary source file is stored" \
  "$(expverdict claude-code "$EXP" src/legacy.ts)" stored
check "a file an import names is loading unknown, not exposed" \
  "$(expverdict claude-code "$EXP" docs/notes.md)" "loading unknown"
check "a file on a configured surface is likely exposed" \
  "$(expverdict codex "$EXP" sub/AGENTS.md)" "likely exposed"
# Every tool that lacks the import syntax says so rather than reporting a
# file as referenced on the strength of another tool's documentation.
check "the import syntax is claude-only" \
  "$("$HYG/bin/exposure" --tool codex "$EXP" 2>/dev/null | grep -c 'so no file is classified as referenced')" 1
check "the claude report does not claim every tool shares its syntax" \
  "$("$HYG/bin/exposure" --tool claude-code "$EXP" 2>/dev/null | grep -c 'so no file is classified as referenced')" 0
check "every report says loading was not observed" \
  "$("$HYG/bin/exposure" --tool cursor "$EXP" 2>/dev/null | grep -c 'not evidence that an agent read it')" 1

# Read-only: the report is a property of the tree, so running it must not move
# the tree. The digest is taken before and after all five tools run.
BEFORE="$(find "$EXP" -type f | sort | while IFS= read -r f; do
  printf '%s %s\n' "$f" "$(cksum < "$f")"; done | cksum)"
for t in claude-code cursor codex copilot generic; do
  "$HYG/bin/exposure" --tool "$t" "$EXP" >/dev/null 2>&1
  "$HYG/bin/exposure" --tool "$t" --format json "$EXP" >/dev/null 2>&1
done
check "exposure writes nothing" "$BEFORE" \
  "$(find "$EXP" -type f | sort | while IFS= read -r f; do
     printf '%s %s\n' "$f" "$(cksum < "$f")"; done | cksum)"

"$HYG/bin/exposure" --tool codex --format json "$EXP" > "$TMP/exp.json" 2>"$TMP/exp.err"
check "exposure json exits 0" "$?" 0
check "exposure json leaves stderr empty" "$(wc -l < "$TMP/exp.err" | tr -d ' ')" 0
python3 - "$TMP/exp.json" <<'PYEOF' && ok "exposure json parses" || bad "exposure json parses"
import json, sys
d = json.load(open(sys.argv[1]))
assert d["schemaVersion"] == 1, d.get("schemaVersion")
assert d["tool"]["name"] == "hygiene"
assert d["agentTool"] == "codex"
assert d["summary"]["findings"] == len(d["findings"])
assert d["summary"]["findings"] == (d["summary"]["likelyExposed"]
    + d["summary"]["loadingUnknown"] + d["summary"]["stored"]), d["summary"]
files = {f["path"]: f for f in d["surfaces"]["files"]}
assert "AGENTS.md" in files and files["AGENTS.md"]["surface"] == "automatic", files
assert "notes/memory.md" not in files, files
assert d["surfaces"]["counts"]["automatic"] == len(
    [f for f in d["surfaces"]["files"] if f["surface"] == "automatic"]), d["surfaces"]
for f in d["findings"]:
    assert set(f) == {"ruleId", "category", "severity", "file", "line",
                      "surface", "exposure", "surfaceReason", "fingerprint",
                      "message", "evidence"}, f
    assert f["exposure"] in ("likely exposed", "loading unknown", "stored"), f
    assert f["surfaceReason"], f
PYEOF

check "a missing --tool is a usage error" \
  "$("$HYG/bin/exposure" "$EXP" >/dev/null 2>&1; echo $?)" 2
check "an unknown tool is refused" \
  "$("$HYG/bin/exposure" --tool nope "$EXP" >/dev/null 2>&1; echo $?)" 2
check "an unknown tool lists the ones it knows" \
  "$("$HYG/bin/exposure" --tool nope "$EXP" 2>&1 | grep -c 'known tools')" 1
check "an unknown format is refused" \
  "$("$HYG/bin/exposure" --tool codex --format xml "$EXP" >/dev/null 2>&1; echo $?)" 2
check "a missing path is refused" \
  "$("$HYG/bin/exposure" --tool codex "$TMP/no-such-dir" >/dev/null 2>&1; echo $?)" 2
check "two paths are refused" \
  "$("$HYG/bin/exposure" --tool codex "$EXP" "$EXP" >/dev/null 2>&1; echo $?)" 2
check "the report is quiet by default" \
  "$("$HYG/bin/exposure" --tool codex "$EXP" 2>&1 >/dev/null | wc -l | tr -d ' ')" 0
check "claude-code is offered as a tool" \
  "$("$HYG/bin/exposure" --help 2>/dev/null | grep -c 'claude-code')" 1
check "hygiene exposure dispatches" \
  "$("$HYG/bin/hygiene" exposure --tool codex "$EXP" 2>/dev/null | grep -c 'documented surfaces')" 1

# A directory that is not a repository has no history and no memory files, but
# it is still a directory of paths, and the surfaces it holds are still real.
PLAINEXP="$TMP/exposure-plain"; guard "$PLAINEXP"; mkdir -p "$PLAINEXP"
printf 'Project instructions.\n' > "$PLAINEXP/AGENTS.md"
check "a non-repository directory is reportable" \
  "$("$HYG/bin/exposure" --tool codex "$PLAINEXP" >/dev/null 2>&1; echo $?)" 0
check "a non-repository directory still classifies paths" \
  "$(expsurface codex "$PLAINEXP" AGENTS.md)" automatic

echo
echo
echo "  ── ghost references ────────────────────────────────────"
# HYG-PHA-002 and HYG-PHA-003 read a reference from three carriers and from
# nowhere else, so most of what follows is a negative: a path that resolves, a
# URL, a placeholder, or a path shown as an example has to stay quiet. The
# exception is a link on disk, which is not a reference anybody wrote but a file
# the repository cannot deliver.
#
# The fixture is a Git repository rather than a plain tree, because two of the
# properties under test are about the difference between tracked, untracked and
# ignored, and that difference only exists in one.
ghost() {
  local d="$TMP/$1"; guard "$d"; rm -rf "$d"; mkdir -p "$d"
  git -C "$d" init -q -b main >/dev/null 2>&1 || true
  git -C "$d" config user.email t@t; git -C "$d" config user.name t
  printf '%s' "$d"
}

# The matched text of every finding of one rule in one file, so a test asserts
# what was seen and not only how many were counted.
refmatch() {
  "$HYG/bin/scan" --format json "$1" 2>/dev/null | python3 -c '
import json, sys
rule, path = sys.argv[1], sys.argv[2]
for f in json.load(sys.stdin)["findings"]:
    if f["ruleId"] == rule and f["file"] == path:
        print(f["match"] if f["match"] is not None else "-")' "$2" "$3"
}
refcount() {
  "$HYG/bin/scan" --format json "$1" 2>/dev/null | python3 -c '
import json, sys
rule = sys.argv[1]
print(sum(1 for f in json.load(sys.stdin)["findings"] if f["ruleId"] == rule))' "$2"
}

GR="$(ghost ghost-refs)"
# The agent configuration directory and the settings file inside it, assembled
# from parts rather than spelled out: a command in this suite should not carry
# the literal path of a persistence-control file, even to write a fixture that
# is nowhere near the real one. Everything here lives under $TMP.
CD=".claude"
CFG="$CD/settings.json"
mkdir -p "$GR/docs/old" "$GR/src" "$GR/$CD" "$GR/test" "$GR/ignored"
printf '# design\n' > "$GR/docs/old/design.md"
printf '# guide\n'  > "$GR/docs/guide.md"
cat > "$GR/README.md" <<'DOC'
# Demo

Missing sibling: [the design](docs/design.md)
Missing after normalisation: [the spec](docs/../deep/spec.md)
A destination with spaces: [the plan](docs/quarterly plan.md)
Missing image: ![diagram](docs/diagram.png)
Valid: [the guide](docs/guide.md)
Valid with a fragment: [top](docs/guide.md#section)
Fragment only: [here](#demo)
External: [site](https://example.com/x)
Mail: [someone](mailto:a@b.example)
Data: [inline](data:text/plain,hello)
Protocol relative: [cdn](//cdn.example.com/x.js)
Placeholder: [setup](/path/to/project/SETUP.md)
Glob: [all](docs/*.md)
Absolute and outside: [hosts](/etc/hosts)

A code span is a sample, not a link: `[sample](docs/not-a-link.md)`.

```
[fenced](docs/also-not-a-link.md)
```
DOC
# The absolute destinations under the scanned root, appended rather than written
# above because they have to carry this fixture's own path, which only exists
# once the directory does. An absolute path under the root is resolved like any
# other reference: the one that is there stays quiet, and the one that is gone is
# reported as the repository path it names. Neither depends on where the fixture
# landed, so the result is the same on macOS and on a Linux runner.
printf 'Absolute and under the root, and there: [the design](%s/docs/old/design.md)\n' "$GR" \
  >> "$GR/README.md"
printf 'Absolute and under the root, and gone: [the notes](%s/docs/old/notes.md)\n' "$GR" \
  >> "$GR/README.md"
cat > "$GR/AGENTS.md" <<'DOC'
# Instructions

The shared rules are in @CLAUDE.md.
The missing ones are in @docs/missing.md.
An address is not an import: docs@example.com
DOC
cat > "$GR/CLAUDE.md" <<'DOC'
# Shared

See @docs/missing-notes.md and the sample `@docs/not-an-import.md`.
DOC
# The import grammar, at the file that carries it. The at-sign opens an address,
# a handle and a package scope as readily as it opens an import, and this file
# holds all three beside the imports a memory file really contains. A parser that
# reads every @token as a path reports the prose; one that reads none of it
# misses the imports. Both halves are counted below.
mkdir -p "$GR/nested"
cat > "$GR/CLAUDE.local.md" <<'DOC'
# Local notes

An address is not an import: team@company.org
An address with a tag is not an import: hello+agents@company.co.uk
An address in punctuation is not an import: (ops@company.org), or "billing@company.org".
A handle is not an import: @nouvic and @someone.
A bare word and a package scope are not imports: @notes or @company/pkg.
Two imports on one line: @docs/missing.md and @./docs/missing-dot.md.
An address and an import on one line: team@company.org, see @docs/missing-with-email.md.
A valid import is not reported: @CLAUDE.md
A sample is not an import: `@docs/in-a-code-span.md`
A personal import outside the root is not a finding: @~/.claude/my-project-instructions.md

```
@docs/in-a-fence.md
```
DOC
# A nested memory file with an import that climbs one level: the reference is
# joined from the nested directory, stays inside the root, and is reported for
# the path it names. From the root the same token would climb out and be dropped.
cat > "$GR/nested/CLAUDE.md" <<'DOC'
# Nested

An import relative to this file: @../docs/missing-nested.md
DOC
cat > "$GR/nested/AGENTS.md" <<'DOC'
# Nested instructions

The nested import is missing: @docs/missing-agents-nested.md
DOC
# A document no row of the exposure table marks as an import carrier. The token
# below is the shape of an import and would be reported if this file were read
# for them, which is what makes it a test of the carrier list rather than of the
# parser.
cat > "$GR/docs/notes.md" <<'DOC'
# Notes

Not an import carrier, so this is prose: @docs/gone-forever.md
DOC
printf 'export const a = 1;\n' > "$GR/src/a.ts"
cat > "$GR/$CFG" <<'DOC'
{
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Read(docs/**)",
      "Read(./docs/guide.md)",
      "Bash(npm test:*)",
      "Read(/Users/someone/projects/legacy/DESIGN.md)",
      "Read(docs/no-such-file.md)"
    ]
  }
}
DOC

# Case 10, in the fixture rather than in a note: a file with the same basename
# exists, in the wrong directory, and must not satisfy the reference.
check "the same basename in another directory does not resolve a reference" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '^docs/design\.md$')" 1
check "every unresolved destination in a document is reported once each" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | wc -l | tr -d ' ')" 5
check "a destination with spaces is matched whole" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '^docs/quarterly plan\.md$')" 1
check "a missing image destination is reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '^docs/diagram\.png$')" 1
check "a documented import of a missing file is reported" \
  "$(refmatch "$GR" HYG-PHA-002 AGENTS.md)" "docs/missing.md"
check "an import is resolved from the importing file" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.md)" "docs/missing-notes.md"
check "an absolute path under the root is resolved against the root" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c "^$GR/docs/old/notes\.md$")" 1
check "an absolute path under the root that is there is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c "^$GR/docs/old/design\.md$")" 0
check "an absolute path under the root reads as a repository path" \
  "$("$HYG/bin/scan" --format json "$GR" 2>/dev/null | python3 -c '
import json, sys
print(sum(1 for f in json.load(sys.stdin)["findings"]
          if f["ruleId"] == "HYG-PHA-002"
          and f["match"] and f["match"].endswith("/docs/old/notes.md")
          and "not found in this repository" in f["evidence"]))')" 1
check "a missing configured path is reported" \
  "$(refmatch "$GR" HYG-PHA-002 "$CFG" | grep -c '^docs/no-such-file\.md$')" 1
check "a path outside the scanned root in agent configuration is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 "$CFG" \
     | grep -c '^/Users/someone/projects/legacy/DESIGN\.md$')" 0

# The negatives. Each of these is a shape a careless resolver reports.
check "a valid relative link is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c 'docs/guide\.md')" 0
check "a fragment on a valid link is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '#section')" 0
check "a fragment-only link is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '^#demo$')" 0
check "external, mail, data and protocol-relative destinations are not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md \
     | grep -Ec 'example\.com|mailto:|data:|cdn\.')" 0
check "a placeholder path is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c 'path/to/project')" 0
check "a glob is not reported" \
