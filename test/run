  "$GR/hygiene-nonexistent-probe/target.md"
check "a valid link to an absolute target is not reported" \
  "$(refmatch "$GR" HYG-PHA-003 docs/guides/abs-good.md | wc -l | tr -d ' ')" 0
# The ignored path is written before the commit, so the link inside it is
# ignored in the tree the scan reads rather than only after the fact.
check "a broken link in an ignored path is not an input" \
  "$(refmatch "$GR" HYG-PHA-003 ignored/ignored-broken.md | wc -l | tr -d ' ')" 0
check "a link is a file-level finding with no line" \
  "$("$HYG/bin/scan" --format json "$GR" 2>/dev/null | python3 -c '
import json, sys
for f in json.load(sys.stdin)["findings"]:
    if f["file"] == "docs/guides/broken.md":
        print(f["line"])')" "None"
# A loop is a link that does not resolve. It is reported, once, and the scan
# terminates rather than following it.
check "a link loop terminates and is reported" "$(refcount "$GR" HYG-PHA-003)" 6

echo "  ── ghost references in the other formats ───────────────"
"$HYG/bin/scan" --format json "$GR" > "$TMP/ghost.json" 2>"$TMP/ghost.err"
check "a tree full of ghost references still exits 0" "$?" 0
check "reporting them writes nothing to stderr" \
  "$(wc -l < "$TMP/ghost.err" | tr -d ' ')" 0
python3 - "$TMP/ghost.json" <<'PYEOF' && ok "json carries both new rules with their evidence" || bad "json ghost shape"
import json, sys
d = json.load(open(sys.argv[1]))
byrule = {}
for f in d["findings"]:
    byrule.setdefault(f["ruleId"], []).append(f)
assert "HYG-PHA-002" in byrule and "HYG-PHA-003" in byrule, sorted(byrule)
for f in byrule["HYG-PHA-002"]:
    assert f["category"] == "phantom-reference", f
    assert f["severity"] == "warning", f
    assert isinstance(f["line"], int), f
    assert f["match"], f
    assert "not found in this repository" in f["evidence"], f
for f in byrule["HYG-PHA-003"]:
    assert f["line"] is None, f
    assert f["fingerprint"].split(":")[1] == "p", f
PYEOF

"$HYG/bin/scan" --format sarif "$GR" > "$TMP/ghost.sarif" 2>/dev/null
python3 - "$TMP/ghost.sarif" <<'PYEOF' && ok "sarif gives a textual reference a line" || bad "sarif ghost location"
import json, sys
d = json.load(open(sys.argv[1]))
run = d["runs"][0]
ids = {r["ruleId"] for r in run["results"]}
assert {"HYG-PHA-002", "HYG-PHA-003"} <= ids, ids
textual = [r for r in run["results"] if r["ruleId"] == "HYG-PHA-002"][0]
assert textual["locations"][0]["physicalLocation"]["region"]["startLine"] >= 1, textual
link = [r for r in run["results"] if r["ruleId"] == "HYG-PHA-003"][0]
assert "region" not in link["locations"][0]["physicalLocation"], link
PYEOF

