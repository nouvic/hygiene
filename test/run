echo "  ── agent instruction residue ───────────────────────────"
# An agent instruction file is prose, and prose residue is already a finding.
# The risk this guards is the opposite one: treating every imperative in an
# instruction file as governance would make the scanner unusable in the one
# file it was built to read.
AI="$(ghost agent-instructions)"
cat > "$AI/CLAUDE.md" <<'DOC'
# Project

Run ./test/run before opening a pull request.
Do not commit generated output.
Use the repository-relative configuration.
The shared conventions are in @docs/conventions.md.
Notes: [the map](docs/map.md)

The user rejected this approach.
We decided never to use the previous workflow.
Claude was told to ignore the old implementation.
DOC
mkdir -p "$AI/docs"
printf '# conventions\n' > "$AI/docs/conventions.md"
printf '# map\n' > "$AI/docs/map.md"
check "an ordinary instruction in an agent file is not governance" \
  "$(refcount "$AI" HYG-GOV-001)" 0
check "an ordinary instruction in an agent file is not residue" \
  "$(refmatch "$AI" HYG-ARG-002 CLAUDE.md \
     | grep -Ec 'Run \./test/run|Do not commit|repository-relative')" 0
check "a past disagreement in an agent file is residue" \
  "$(refcount "$AI" HYG-ARG-002)" 3
check "a valid import in an agent file is not reported" \
  "$(refmatch "$AI" HYG-PHA-002 CLAUDE.md | wc -l | tr -d ' ')" 0
check "a valid link in an agent file is not reported" \
  "$(refcount "$AI" HYG-PHA-002)" 0
printf '\nSee @docs/removed.md for the old flow.\n' >> "$AI/CLAUDE.md"
check "a missing import in an agent file is reported" \
  "$(refmatch "$AI" HYG-PHA-002 CLAUDE.md)" "docs/removed.md"
printf '\nSee [the removed map](docs/removed-map.md).\n' >> "$AI/CLAUDE.md"
check "a deleted document linked from an agent file is reported" \
