# A path that climbs out of the scanned root is not resolved and not reported,
# and nothing outside the root is read to decide that.
check "a reference that escapes the repository is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c 'etc/hosts')" 0
check "an absolute path outside the repository is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '^/etc/hosts$')" 0
ESCAPE="$(ghost ghost-escape)"
# The file the escaping link names does exist, one level above the root, so a
# resolver that followed it would find it and call the reference sound. It is
# not read, and the reference is not reported either.
printf 'outside\n' > "$TMP/outside.md"
printf '# up\n\n[out](../outside.md)\n[gone](../never-there.md)\n' > "$ESCAPE/up.md"
check "a relative path that climbs above the root is not reported" \
  "$(refmatch "$ESCAPE" HYG-PHA-002 up.md | wc -l | tr -d ' ')" 0
check "a file outside the root is not evidence about the root" \
  "$(refmatch "$ESCAPE" HYG-PHA-002 up.md | grep -c 'outside')" 0
check "scanning a tree with an escaping reference still exits 0" \
  "$("$HYG/bin/scan" "$ESCAPE" >/dev/null 2>&1; echo $?)" 0

# An absolute path outside the scanned root is outside this rule, and a path
# written with a leading tilde is the same thing written short. Neither is
# opened, so neither is reported, and the answer does not depend on whether the
# file is there. The fixture below carries both halves of that pair: for each
# home-style prefix a directory that exists on the machine running the suite,
# when it does, and a name that cannot exist on any machine.
printf 'Tilde: [personal](~/.claude/my-project-instructions.md)\n' >> "$GR/README.md"
for dir in /Users /home /Volumes; do
  [ -d "$dir" ] && printf 'Outside, and there: [dir](%s)\n' "$dir" >> "$GR/README.md"
  printf 'Outside, and gone: [probe](%s/hygiene-nonexistent-probe/notes.md)\n' "$dir" \
    >> "$GR/README.md"
done
# The home directory itself is the half that certainly exists on the machine
# running the suite, and its prefix is /Users or /home on the platforms this
# project supports. Beside it, a name that certainly does not.
printf 'Outside, and there: [home](%s)\n' "$HOME" >> "$GR/README.md"
printf 'Outside, and gone: [home notes](%s/hygiene-nonexistent-probe.md)\n' "$HOME" \
  >> "$GR/README.md"
check "a personal import outside the root is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 CLAUDE.local.md | grep -c 'my-project-instructions')" 0
check "a tilde destination outside the root is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '^~/')" 0
check "an absolute path outside the root is not reported, existing or not" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -Fv "$GR" | grep -Ec '^/|^~')" 0
check "a path under a home directory outside the root is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -Ec '^(/Users|/home)')" 0
check "a mount path outside the root is not reported" \
  "$(refmatch "$GR" HYG-PHA-002 README.md | grep -c '^/Volumes')" 0
check "scanning a tree carrying outside-root references still exits 0" \
  "$("$HYG/bin/scan" "$GR" >/dev/null 2>&1; echo $?)" 0

# An exempt path is not an input. A test fixture is allowed to hold a link
# whose target is not there — that is what a fixture is for.
printf '# fixture\n\n[missing](docs/gone.md)\n' > "$GR/test/fixture-notes.md"
check "a broken reference inside a test fixture is exempt" \
