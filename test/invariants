#!/usr/bin/env bash
# test/invariants — tripwires for the tool's static security properties.
#
#   test/invariants [root]      exit 0 if the tree holds them, 1 if not
#
# These are greps, not proofs: a tripwire makes a violation loud in review and
# in CI, so a hostile change has to visibly break stated policy instead of
# hiding in a large diff. The behavioural properties (hooks failing open, the
# scanner writing nothing, the suite's sandbox) are asserted by the test suite;
# these are the static ones. The [root] argument exists so the suite can prove
# the tripwire fires on a tampered copy.

set -uo pipefail
ROOT="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
FAIL=0

# Everything that executes on a user's machine — the list a reviewer checks
# when a change adds a new executable.
SURFACE="bin/hygiene bin/scan bin/rulings bin/memory bin/explain bin/exposure
install install-claude uninstall action.yml
hooks/pre-commit hooks/commit-msg hooks/check-style
lib/patterns.sh lib/rules.sh lib/findings.sh lib/report.sh lib/exposure.sh
lib/references.sh
claude/pretooluse-hygiene.sh claude/pretooluse-rulings.py
claude/pretooluse-persistence.py claude/posttooluse-commit-failure.py
claude/stop-rulings.py claude/prompt-style.py claude/pretooluse-style.py"

# ── 1. nothing touches the network ─────────────────────────────────────────
# Command names are anchored so that an ordinary word containing one does not
# trip the wire. "truncate" holds "ncat" four characters in, and a tripwire that
# fires on a helper name is a tripwire that gets an exemption added to it.
NET='(^|[^[:alnum:]_])(curl|wget|nc|ncat|telnet)([^[:alnum:]_]|$)|/dev/tcp|urllib|http\.client|\bsocket\b|requests\.|fetch\('
for f in $SURFACE; do
  [ -f "$ROOT/$f" ] || continue
  hit="$(grep -nE "$NET" "$ROOT/$f" 2>/dev/null || true)"
  if [ -n "$hit" ]; then
    printf '  ✗ network primitive in %s\n' "$f"
    printf '%s\n' "$hit" | head -3 | sed 's/^/      /'
    FAIL=1
  fi
done
[ "$FAIL" = 0 ] && printf '  ✓ no network primitives in the executable surface\n'

# ── 2. python is stdlib-only, from a named allowlist ───────────────────────
ALLOWED='difflib|glob|hashlib|importlib|json|os|re|signal|sys|time'
BAD="$(grep -hoE '^(import|from) [A-Za-z_., ]+' \
        "$ROOT"/claude/*.py "$ROOT/bin/rulings" "$ROOT/bin/memory" 2>/dev/null \
      | tr ',' '\n' | sed -E 's/^(import|from) //; s/\..*$//; s/ //g' \
      | sort -u | grep -vE "^($ALLOWED)$" || true)"
if [ -n "$BAD" ]; then
  printf '  ✗ import outside the stdlib allowlist:\n'
  printf '%s\n' "$BAD" | sed 's/^/      /'
  FAIL=1
else
  printf '  ✓ python imports stay on the stdlib allowlist\n'
fi


# ── 3. AGENTS.md routes a maintainer before it instructs an installer ──────
# The root AGENTS.md is written for an agent installing this tool into someone
# else's project. An agent working on this repository is a different reader,
# and the failure mode is specific: it follows the installation steps against
# this checkout and commits a copy of the tool's own hooks as its first change.
# The routing block is the only thing separating the two jobs, so its
# position above the installation steps and the one sentence that forbids
# installing here are both tripwires.
AGENTS="$ROOT/AGENTS.md"
if [ ! -f "$AGENTS" ]; then
  printf '  ✗ AGENTS.md is missing; nothing separates installing from developing\n'
  FAIL=1
else
  route_at="$(grep -n '^## Which of these two jobs is yours$' "$AGENTS" \
              | head -1 | cut -d: -f1)"
  install_at="$(grep -n '^# Installing this' "$AGENTS" | head -1 | cut -d: -f1)"
  if [ -z "$route_at" ] || [ -z "$install_at" ] || [ "$route_at" -ge "$install_at" ]; then
    printf '  ✗ AGENTS.md does not route a reader before it instructs one\n'
    printf '      routing heading at line %s, installation heading at line %s\n' \
      "${route_at:-none}" "${install_at:-none}"
    FAIL=1
  else
    route_block="$(sed -n "${route_at},${install_at}p" "$AGENTS")"
    miss=""
    printf '%s\n' "$route_block" | grep -q 'CONTRIBUTING.md' \
      || miss="$miss CONTRIBUTING.md"
    printf '%s\n' "$route_block" | grep -q '\./test/run' || miss="$miss test/run"
    printf '%s\n' "$route_block" | grep -q '\./test/invariants' \
      || miss="$miss test/invariants"
    printf '%s\n' "$route_block" | grep -q 'Do not install Hygiene into this repository' \
      || miss="$miss the-prohibition"
    if [ -n "$miss" ]; then
      printf '  ✗ the AGENTS.md routing block has lost:%s\n' "$miss"
      FAIL=1
    else
      printf '  ✓ AGENTS.md routes a maintainer to CONTRIBUTING.md and the tests\n'
    fi
  fi
fi

# ── 4. every rule identifier the docs cite exists ──────────────────────────
# Rule identifiers are stable and are cited by baselines, CI annotations, bug
# reports, and the documentation. A typo sends a reader to `hygiene explain`
# for a rule that does not exist, and nothing else here would ever notice.
# lib/rules.sh is the registry; docs/rules.md is where a reader goes next, so
# the two directions are checked against each other. A tampered copy built by
# the suite has neither file, and that is a skip, not a pass.
if [ ! -f "$ROOT/lib/rules.sh" ]; then
  printf '  - no rule registry under %s; identifier check skipped\n' "$ROOT"
else
  . "$ROOT/lib/rules.sh"
  cited="$(grep -rhoE 'HYG-[A-Z]{3}-[0-9]{3}' \
             "$ROOT/README.md" "$ROOT/AGENTS.md" "$ROOT/TODO.md" \
             "$ROOT/docs" "$ROOT/benchmark" 2>/dev/null | sort -u)"
  unknown=""
  for r in $cited; do
    hyg_rule_exists "$r" || unknown="$unknown $r"
  done
  undoc=""
  if [ -f "$ROOT/docs/rules.md" ]; then
    for r in $HYG_RULES; do
      grep -q "$r" "$ROOT/docs/rules.md" || undoc="$undoc $r"
    done
  fi
  if [ -n "$unknown$undoc" ]; then
    [ -n "$unknown" ] \
      && printf '  ✗ cited in the docs but absent from the registry:%s\n' "$unknown"
    [ -n "$undoc" ] \
      && printf '  ✗ registered but absent from docs/rules.md:%s\n' "$undoc"
    FAIL=1
  else
    printf '  ✓ every documented rule identifier exists\n'
  fi
fi

# ── 5. relative documentation links resolve ────────────────────────────────
# Every claim in this repository is meant to be checkable, and a relative link
# is how a reader gets from a summary to the thing that backs it. A link that
# 404s is a citation nobody can follow, so the shipped documentation is walked
# for relative targets and each one must exist in the tree. Absolute URLs,
# mailto links, and same-page anchors carry no local target and are skipped.
if [ ! -d "$ROOT/docs" ]; then
  printf '  - no documentation tree under %s; link check skipped\n' "$ROOT"
else
  broken=""
  for f in "$ROOT/README.md" "$ROOT/AGENTS.md" "$ROOT/CONTRIBUTING.md" \
           "$ROOT/SECURITY.md" "$ROOT"/docs/*.md; do
    [ -f "$f" ] || continue
    dir="$(dirname "$f")"
    # Destinations are taken the way the scanner takes them: a fenced block is
    # not prose, and a code span is a sample rather than a link. Without that,
    # a document that shows link syntax would have to name a real file every
    # time it illustrated one, and this check would be enforcing something the
    # tool does not do.
    while IFS= read -r link; do
      [ -n "$link" ] || continue
      case "$link" in
        *://*|mailto:*|'#'*) continue ;;
      esac
      target="${link%%#*}"
      target="${target%% *}"
      [ -n "$target" ] || continue
      [ -e "$dir/$target" ] || broken="$broken
      ${f##*/} -> $link"
    done <<EOF
$(awk 'BEGIN { f = 0 }
  /^[[:space:]]*(```|~~~)/ { f = !f; next }
  f { next }
  { line = $0; gsub(/`[^`]*`/, "", line)
    while (match(line, /\]\([^)]+\)/)) {
      printf "%s\n", substr(line, RSTART + 2, RLENGTH - 3)
      line = substr(line, RSTART + RLENGTH)
    } }' "$f" 2>/dev/null)
EOF
  done
  if [ -n "$broken" ]; then
    printf '  ✗ relative documentation links with no target:%s\n' "$broken"
    FAIL=1
  else
    printf '  ✓ relative documentation links resolve\n'
  fi
fi

exit "$FAIL"
