#!/usr/bin/env bash
# commit-msg — a commit describes a change. It is not a session handoff.
#
# Git history is read by every future agent. Session notes written here become
# standing orders nobody remembers issuing.

set -uo pipefail

_hyg_d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HYG_HOME=""
for _c in "${HYGIENE_HOME:-}" "$_hyg_d" "$_hyg_d/.."; do
  [ -n "$_c" ] && [ -f "$_c/lib/patterns.sh" ] && { HYG_HOME="$_c"; break; }
done
[ -n "$HYG_HOME" ] || exit 0
. "$HYG_HOME/lib/patterns.sh"
hyg_color

[ "${HYGIENE_SKIP:-0}" = "1" ] && exit 0

MSG_FILE="$1"
BODY="$(grep -v '^#' "$MSG_FILE" 2>/dev/null)"
SUBJECT="$(printf '%s\n' "$BODY" | grep -v '^[[:space:]]*$' | head -1)"
[ -n "$SUBJECT" ] || exit 0

# Merge, revert and fixup commits are generated by git; leave them alone.
printf '%s' "$SUBJECT" | grep -Eq '^(Merge|Revert|fixup!|squash!)' && exit 0

fail() {
  printf '\n%s  ✗ %s%s\n\n' "$HYG_RED" "$1" "$HYG_OFF" >&2
  printf '    %s\n' "$SUBJECT" >&2
  printf '\n%s    %s%s\n\n' "$HYG_DIM" "$2" "$HYG_OFF" >&2
  exit 1
}

if printf '%s' "$SUBJECT" | grep -Eqi "$HYG_COMMIT_BANNED"; then
  fail "commit subject is a session note, not a change" \
"A handoff belongs in your working notes, not in git history.
    Describe what this commit does:  fix(nav): point CTA at membership"
fi

if ! printf '%s' "$SUBJECT" | grep -Eq "$HYG_CONVENTIONAL"; then
  fail "commit subject is not a conventional commit" \
"Expected  type(scope): subject
    Types     feat fix docs style refactor perf test build ci chore revert"
fi

if [ "${#SUBJECT}" -gt 72 ]; then
  fail "commit subject is ${#SUBJECT} characters (max 72)" \
"Put the detail in the body."
fi

# The body may explain *this change*. It may not issue orders to future readers.
BODY_REST="$(printf '%s\n' "$BODY" | tail -n +2)"
if [ -n "$BODY_REST" ]; then
  HITS="$(printf '%s\n' "$BODY_REST" | hyg_match_governance)"
  if [ -n "$HITS" ]; then
    printf '\n%s  ✗ governance in a commit message%s\n\n' "$HYG_RED" "$HYG_OFF" >&2
    printf '%s\n' "$HITS" | cut -c1-110 | sed 's/^/    /' >&2
    printf '\n%s    A commit body explains this change. It does not instruct future readers.%s\n\n' \
      "$HYG_DIM" "$HYG_OFF" >&2
    exit 1
  fi
fi
exit 0
