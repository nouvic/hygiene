#!/usr/bin/env bash
# scan — read-only diagnostic. Reports what an agent reads before it reads your code.
# Never writes, never fails a build. Exit status is 0 for any scan that ran; 2 for a
# usage error. The one exception to "never writes" is --write-baseline, which writes
# only the file you name.
#
#   scan [path]                      text report on stdout
#   scan --format json|sarif [path]  structured report on stdout
#   scan --write-baseline [path]     record the current findings as a baseline
#   scan --new --baseline [path]     report only findings the baseline does not hold

set -uo pipefail

_hyg_d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HYG_HOME=""
for _c in "$_hyg_d" "$_hyg_d/.."; do
  [ -f "$_c/lib/patterns.sh" ] && { HYG_HOME="$(cd "$_c" && pwd)"; break; }
done
[ -n "$HYG_HOME" ] || { echo "hygiene: patterns library not found" >&2; exit 0; }
. "$HYG_HOME/lib/patterns.sh"
. "$HYG_HOME/lib/rules.sh"
. "$HYG_HOME/lib/findings.sh"
. "$HYG_HOME/lib/report.sh"
hyg_color
HYG_VERSION="$(cat "$HYG_HOME/VERSION" 2>/dev/null || echo unknown)"

usage() {
  cat <<'USAGE'
usage: scan [options] [path]

  (no options)                     text report on stdout, writes nothing
  --format text|json|sarif         output format. text is the default
  --write-baseline[=path]          write the current findings to a baseline
                                   (default: <path>/.hygiene-baseline)
  --new                            report only findings not in the baseline
  --baseline[=path]                the baseline to compare against
  -h, --help                       this text

A relative --baseline path resolves against the scanned path, the same way
.hygieneignore does. --new without an existing baseline is an error, not an
empty baseline: an unreadable baseline must not report every finding as new.
USAGE
}

FORMAT=text; ARG_ROOT="."; ROOT_SET=0
NEW_ONLY=0; WRITE_BASELINE=0; BASELINE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --format)         FORMAT="${2:-}"; shift 2 ;;
    --format=*)       FORMAT="${1#*=}"; shift ;;
    --write-baseline) WRITE_BASELINE=1; shift ;;
    --write-baseline=*) WRITE_BASELINE=1; BASELINE="${1#*=}"; shift ;;
    --baseline)       BASELINE="${2:-}"; shift 2 ;;
    --baseline=*)     BASELINE="${1#*=}"; shift ;;
    --new)            NEW_ONLY=1; shift ;;
    -h|--help)        usage; exit 0 ;;
    -*)               printf 'scan: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *)                if [ "$ROOT_SET" = 1 ]; then
                        printf 'scan: unexpected argument: %s\n' "$1" >&2; exit 2
                      fi
                      ARG_ROOT="$1"; ROOT_SET=1; shift ;;
  esac
done

case "$FORMAT" in
  text|json|sarif) ;;
  *) printf 'scan: --format must be text, json or sarif, not %s\n' "${FORMAT:-}" >&2; exit 2 ;;
esac
if [ "$WRITE_BASELINE" = 1 ] && [ "$NEW_ONLY" = 1 ]; then
  printf 'scan: --write-baseline and --new cannot be used together\n' >&2; exit 2
fi

ROOT="$(cd "$ARG_ROOT" 2>/dev/null && pwd)" || { printf 'scan: no such path: %s\n' "$ARG_ROOT" >&2; exit 2; }
cd "$ROOT" || exit 2

EXTRA="$(hyg_extra_exempt "$ROOT")"
IN_GIT=0
git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 && IN_GIT=1

list_files() { hyg_list_files "$ROOT"; }

SRC=""; DOCS=""
while IFS= read -r f; do
  [ -f "$f" ] || continue
  hyg_is_exempt "$f" "$EXTRA" && continue
  if printf '%s' "$f" | grep -Eq "$HYG_DOC_EXT"; then DOCS="$DOCS$f
"
  elif printf '%s' "$f" | grep -Eq "$HYG_SRC_EXT"; then SRC="$SRC$f
"
  fi
done <<EOF
$(list_files | grep -Ev "$HYG_EXEMPT_PATHS")
EOF

FINDINGS="$(hyg_findings "$ROOT")"
# History findings belong in the report as much as the rest: a rule that only
# the text report mentioned would be missing from every structured consumer.
if [ "$IN_GIT" = 1 ]; then
  HIST="$(hyg_findings_history "$ROOT")"
  [ -n "$HIST" ] && FINDINGS="$FINDINGS$HIST
"
fi
ROWS="$(printf '%s\n' "$FINDINGS" | hyg_rows)"

# ------------------------------------------------------------------ baseline
BASELINE_PATH=""; BASELINE_LABEL=""; SUPPRESSED=0
if [ "$WRITE_BASELINE" = 1 ] || [ "$NEW_ONLY" = 1 ]; then
  if [ -n "$BASELINE" ]; then
    case "$BASELINE" in /*) BASELINE_PATH="$BASELINE" ;; *) BASELINE_PATH="$ROOT/$BASELINE" ;; esac
  else
    BASELINE_PATH="$ROOT/.hygiene-baseline"
  fi
  case "$BASELINE_PATH" in
    "$ROOT"/*) BASELINE_LABEL="${BASELINE_PATH#"$ROOT"/}" ;;
    *)         BASELINE_LABEL="$BASELINE_PATH" ;;
  esac
fi

if [ "$NEW_ONLY" = 1 ]; then
  BASELINE_SET="$(hyg_baseline_read "$BASELINE_PATH")" || exit 2
  KEPT=""
  while IFS="$US" read -r rule catg sev file line match fp ev; do
    [ -n "$rule" ] || continue
    if printf '%s\n' "$BASELINE_SET" | grep -Fxq "$fp"; then
      SUPPRESSED=$((SUPPRESSED + 1)); continue
    fi
    KEPT="$KEPT$rule$US$catg$US$sev$US$file$US$line$US$match$US$fp$US$ev
"
  done <<EOF
$ROWS
EOF
  ROWS="$KEPT"
fi

if [ "$WRITE_BASELINE" = 1 ]; then
  hyg_baseline_write "$BASELINE_PATH" <<EOF
$ROWS
EOF
  N_ROWS=0
  [ -n "$ROWS" ] && N_ROWS="$(printf '%s\n' "$ROWS" | wc -l | tr -d ' ')"
  printf 'scan: wrote %s findings to %s\n' "$N_ROWS" "$BASELINE_PATH" >&2
fi

# The findings of one rule, as four fields: file, line, narrow match, whole
# evidence line. The fields are joined with a unit separator rather than a tab
# because a tab is IFS whitespace, and splitting on it silently collapses the
# empty line and match fields that file-level findings carry.
select_rule() {
  local rule catg sev f ln m fp ev
  while IFS="$US" read -r rule catg sev f ln m fp ev; do
    [ "$rule" = "$1" ] || continue
    printf '%s\n' "$f$US$ln$US$m$US$ev"
  done <<EOF
$ROWS
EOF
}

# Structured output replaces the text report rather than following it: a
# document on stdout has to be the whole document.
if [ "$FORMAT" != text ]; then
  case "$FORMAT" in
    json)  hyg_render_json  "$ARG_ROOT" "$BASELINE_LABEL" "$SUPPRESSED" <<EOF
$ROWS
EOF
           ;;
    sarif) hyg_render_sarif "$ARG_ROOT" "$BASELINE_LABEL" "$SUPPRESSED" <<EOF
$ROWS
EOF
           ;;
  esac
  exit 0
fi

printf '\n%s%s%s\n' "$HYG_BLD" "  agent hygiene · $ROOT" "$HYG_OFF"
printf '%s\n\n' "$HYG_DIM  ────────────────────────────────────────────────$HYG_OFF"

# ─────────────────────────────────────────────── 1. comment density
DENSE=""; TOT_SRC=0; TOT_CMT=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  total=$(wc -l < "$f" 2>/dev/null | tr -d ' '); [ "${total:-0}" -gt 0 ] || continue
  cmt=$(hyg_comment_lines "$f" | wc -l | tr -d ' ')
  TOT_SRC=$((TOT_SRC + total)); TOT_CMT=$((TOT_CMT + cmt))
  [ "$total" -ge "$HYG_VOLUME_MIN_LINES" ] || continue
  pct=$(( cmt * 100 / total ))
  [ "$pct" -ge "$HYG_VOLUME_PCT" ] && DENSE="$DENSE$(printf '%3d%%  %5s lines  %s' "$pct" "$total" "$f")
"
done <<EOF
$SRC
EOF

OVERALL=0; [ "$TOT_SRC" -gt 0 ] && OVERALL=$(( TOT_CMT * 100 / TOT_SRC ))
printf '  %scomment density%s   %s%% of source is comment  (%s / %s lines)\n' \
  "$HYG_BLD" "$HYG_OFF" "$OVERALL" "$TOT_CMT" "$TOT_SRC"
if [ -n "$DENSE" ]; then
  printf '%s' "$DENSE" | sort -rn | head -8 | while IFS= read -r l; do
    [ -n "$l" ] && printf '    %s%s%s\n' "$HYG_YEL" "$l" "$HYG_OFF"
  done
fi
echo

# ─────────────────────────────────────────────── 2. governance in comments
GOV=""; GOV_N=0
while IFS="$US" read -r f ln m ev; do
  [ -n "$f" ] || continue
  GOV_N=$((GOV_N + 1))
  GOV="$GOV$f:$ln:$ev
"
done <<EOF
$(select_rule HYG-GOV-001)
EOF

if [ "$GOV_N" -gt 0 ]; then
  printf '  %sgovernance in comments%s   %s%s lines%s — potential rules and rulings in source\n' \
    "$HYG_BLD" "$HYG_OFF" "$HYG_RED" "$GOV_N" "$HYG_OFF"
  printf '%s' "$GOV" | head -6 | cut -c1-118 | sed 's/^/    /'
  [ "$GOV_N" -gt 6 ] && printf '    %s… %s more%s\n' "$HYG_DIM" "$((GOV_N - 6))" "$HYG_OFF"
else
  printf '  %sgovernance in comments%s   %snone%s\n' "$HYG_BLD" "$HYG_OFF" "$HYG_GRN" "$HYG_OFF"
fi
echo

# ─────────────────────────────────────────────── 3. argument residue
RES_N=0; RES=""
while IFS="$US" read -r f ln m ev; do
  [ -n "$f" ] || continue
  RES_N=$((RES_N + 1))
  RES="$RES$f:$ln:$ev
"
done <<EOF
$(select_rule HYG-ARG-001; select_rule HYG-ARG-002)
EOF

if [ "$RES_N" -gt 0 ]; then
  printf '  %sargument residue%s   %s%s lines%s — records of past disagreements\n' \
    "$HYG_BLD" "$HYG_OFF" "$HYG_RED" "$RES_N" "$HYG_OFF"
  printf '%s' "$RES" | head -4 | cut -c1-118 | sed 's/^/    /'
else
  printf '  %sargument residue%s   %snone%s\n' "$HYG_BLD" "$HYG_OFF" "$HYG_GRN" "$HYG_OFF"
fi
echo

# ─────────────────────────────────────────────── 4. phantom authority
PH=""; PH_N=0
# Section 7 fills these in, but only inside a Git repository. The verdict below
# counts them, so they have to exist either way.
DEL_F=0; DEL_L=0
while IFS="$US" read -r f ln m ev; do
  [ -n "$f" ] || continue
  PH_N=$((PH_N + 1)); PH="$PH  $f → $m
"
done <<EOF
$(select_rule HYG-PHA-001)
EOF

if [ "$PH_N" -gt 0 ]; then
  printf '  %sphantom authority%s   %s%s references%s — cited documents that do not exist\n' \
    "$HYG_BLD" "$HYG_OFF" "$HYG_RED" "$PH_N" "$HYG_OFF"
  printf '%s' "$PH" | head -5 | sed 's/^/  /'
else
  printf '  %sphantom authority%s   %snone%s\n' "$HYG_BLD" "$HYG_OFF" "$HYG_GRN" "$HYG_OFF"
fi
echo

# ─────────────────────────────────────────────── 5. document volume
MD_N=0; MD_F=0
for d in $DOCS; do
  [ -f "$d" ] || continue
  MD_F=$((MD_F + 1)); MD_N=$((MD_N + $(wc -l < "$d" | tr -d ' ')))
done
printf '  %smarkdown%s   %s lines across %s files\n' "$HYG_BLD" "$HYG_OFF" "$MD_N" "$MD_F"
echo

# ─────────────────────────────────────────────── 6. monotonic growth
if [ "$IN_GIT" = 1 ]; then
  GROW=""
  for d in $DOCS; do
    stats=$(git -C "$ROOT" log --follow --numstat --format='' -- "$d" 2>/dev/null | awk 'NF==3 {print $1" "$2}')
    [ -n "$stats" ] || continue
    revs=$(printf '%s\n' "$stats" | wc -l | tr -d ' ')
    [ "$revs" -ge 3 ] || continue
    shrank=$(printf '%s\n' "$stats" | awk '$2>$1 {c++} END{print c+0}')
    [ "$shrank" = "0" ] && GROW="$GROW    $d  ($revs revisions, never shrank)
"
  done
  if [ -n "$GROW" ]; then
    printf '  %smonotonic growth%s   %saccreting, not maintained%s\n' \
      "$HYG_BLD" "$HYG_OFF" "$HYG_RED" "$HYG_OFF"
    printf '%s' "$GROW"
  else
    printf '  %smonotonic growth%s   %snone%s\n' "$HYG_BLD" "$HYG_OFF" "$HYG_GRN" "$HYG_OFF"
  fi
  echo

  # ───────────────────────────────────────────── 7. history contamination
  # The counts come from the same rows the structured formats carry, so the
  # report and the JSON can never disagree about what was found.
  DEL_F=0; DEL_L=0
  while IFS="$US" read -r f ln m ev; do
    [ -n "$f" ] || continue
    DEL_F=$((DEL_F + 1))
    DEL_L=$((DEL_L + ${ev%% *}))
  done <<EOF
$(select_rule HYG-HIS-001)
EOF
  if [ "$DEL_F" -gt 0 ]; then
    printf '  %shistory%s   %s%s lines in %s deleted documents, retrievable in one command%s\n' \
      "$HYG_BLD" "$HYG_OFF" "$HYG_RED" "$DEL_L" "$DEL_F" "$HYG_OFF"
    printf '    %sthese documents are absent from disk but remain retrievable from Git%s\n' \
      "$HYG_DIM" "$HYG_OFF"
  else
    printf '  %shistory%s   %sclean%s\n' "$HYG_BLD" "$HYG_OFF" "$HYG_GRN" "$HYG_OFF"
  fi
  echo
fi

# ─────────────────────────────────────────────── verdict
# Counted from the same rows the structured formats carry, so the number in the
# text summary is the number of findings in the JSON. The per-section counters
# above are for the headings; this is the total.
TOTAL="$(printf '%s\n' "$ROWS" | grep -c . || true)"
printf '%s\n' "$HYG_DIM  ────────────────────────────────────────────────$HYG_OFF"
if [ "$NEW_ONLY" = 1 ]; then
  printf '  %snew only%s   %s findings suppressed by %s\n' \
    "$HYG_BLD" "$HYG_OFF" "$SUPPRESSED" "${BASELINE_LABEL:-$BASELINE_PATH}"
fi
if [ "$TOTAL" = 0 ] && [ "$OVERALL" -lt 15 ]; then
  printf '  %sclean.%s No matches under the current patterns and exemptions.\n\n' "$HYG_GRN" "$HYG_OFF"
else
  NOUN="candidate findings"; [ "$TOTAL" = 1 ] && NOUN="candidate finding"
  printf '  %s%s %s%s across categories; review for false positives and overlap.\n' \
    "$HYG_BLD" "$TOTAL" "$NOUN" "$HYG_OFF"
  printf '  %sRun `hygiene install` in this repo to stop more accumulating.%s\n\n' "$HYG_DIM" "$HYG_OFF"
fi
exit 0
